{
	"$schema": "https://cdn.jsdelivr.net/npm/wrangler/config-schema.json",
	"name": "nurulhudaapon",
	"main": "app/main.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "2f723ba2ce6c4d2e816369e709427cd7"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"migrations_dir": "./app/db/migrations",
			"database_id": "13f22d54-6d81-4a60-a1cc-aac07cde60dd"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "CALENDAR_SYNC",
				"queue": "calendar-sync"
			}
		],
		"consumers": [
			{
				"queue": "calendar-sync",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3
			}
		]
	},
	"build": {
		"watch_dir": "./app",
		"command": "zig build zx -- build --target wasm32-wasi --release small --prerender",
	},
	"assets": {
		"directory": "./zig-out/static",
		"binding": "ASSETS"
	},
	  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
  },
}