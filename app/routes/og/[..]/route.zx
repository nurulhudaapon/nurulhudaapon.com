pub fn GET(ctx: zx.RouteContext) !void {
    const pathname = ctx.request.pathname;
    const name = pathname["/og/".len..(pathname.len - ".png".len)];

    if (std.mem.eql(u8, name, "avatar")) {
        const bytes = try avatar.fetch(ctx.arena, ctx.io);
        ctx.response.text(bytes);
        ctx.response.setContentType(avatar.contentType(bytes));
        ctx.response.headers.append("Cache-Control", "public, max-age=86400");
        return;
    }

    registerFonts();

    var props = try propsFor(ctx.arena, ctx.io, name);
    if (try queryText(ctx, "title")) |title| {
        props.title = title;
        props.title_lines = try wrapText(ctx.arena, title, maxChars(props.title_size));
    }
    if (try queryText(ctx, "subtitle")) |subtitle| {
        props.subtitle = if (subtitle.len == 0) &.{} else try ctx.arena.dupe([]const u8, &.{subtitle});
    }
    if (try queryText(ctx, "meta")) |meta| props.meta = meta;
    props.avatar_href = try avatar.dataUri(ctx.arena, ctx.io);

    var aw: std.Io.Writer.Allocating = .init(ctx.arena);
    try Card(ctx.arena, props).render(&aw.writer, .{});
    const png = try lunasvg.svgToPngAlloc(ctx.arena, aw.written(), 1200, 630, 0xff000000);

    ctx.response.text(png);
    ctx.response.setContentType(.@"image/png");
}

fn queryText(ctx: zx.RouteContext, name: []const u8) !?[]const u8 {
    const raw = ctx.request.query.get(name) orelse return null;
    const buf = try ctx.arena.dupe(u8, raw);
    std.mem.replaceScalar(u8, buf, '+', ' ');
    return std.Uri.percentDecodeInPlace(buf);
}

var fonts_registered: std.atomic.Value(bool) = .init(false);

fn registerFonts() void {
    if (fonts_registered.swap(true, .acq_rel)) return;
    const bold = lunasvg.addFontFaceFromData("Geist", true, false, geist_fonts.bold);
    const regular = lunasvg.addFontFaceFromData("Geist", false, false, geist_fonts.regular);
    if (!bold or !regular) {
        fonts_registered.store(false, .release);
        std.log.warn("lunasvg: failed to register Geist fonts", .{});
    }
}

fn propsFor(arena: std.mem.Allocator, io: std.Io, name: []const u8) !Props {
    for (pages) |page| {
        if (std.mem.eql(u8, page.path, name)) return sitePage(arena, page);
    }
    if (std.mem.startsWith(u8, name, "blog/")) {
        if (blogPost(arena, io, name)) |props| return props else |_| {}
    }
    return sitePage(arena, home);
}

fn sitePage(arena: std.mem.Allocator, page: Props) !Props {
    var props = page;
    props.title_size = siteTitleSize(page.title);
    props.title_lines = try wrapText(arena, page.title, maxChars(props.title_size));
    return props;
}

fn blogPost(arena: std.mem.Allocator, io: std.Io, name: []const u8) !Props {
    const post = try posts.get(arena, io, name["blog/".len..], .none);
    const title = try truncate(arena, stripTrailingEmoji(post.title), 56);
    const title_size = blogTitleSize(title);
    return .{
        .kind = .blog,
        .path = name,
        .title = title,
        .title_lines = try wrapText(arena, title, maxChars(title_size)),
        .title_size = title_size,
        .meta = try arena.print("{s}  ·  {s}  ·  {d} min read", .{ posts.author, post.date, post.read_minutes }),
    };
}

fn siteTitleSize(title: []const u8) u32 {
    if (title.len <= 18) return 52;
    if (title.len <= 28) return 40;
    return 34;
}

fn blogTitleSize(title: []const u8) u32 {
    if (title.len <= 22) return 48;
    if (title.len <= 40) return 40;
    return 34;
}

fn maxChars(title_size: u32) usize {
    return switch (title_size) {
        48 => 26,
        40 => 32,
        else => 38,
    };
}

fn wrapText(arena: std.mem.Allocator, text: []const u8, max_chars: usize) ![]const []const u8 {
    if (text.len <= max_chars) return arena.dupe([]const u8, &.{text});

    var lines: std.ArrayList([]const u8) = .empty;

    var start: usize = 0;
    while (start < text.len and lines.items.len < 3) {
        if (text.len - start <= max_chars) {
            try lines.append(arena, text[start..]);
            break;
        }

        var end = start + max_chars;
        while (end > start and text[end - 1] != ' ') : (end -= 1) {}
        if (end <= start) end = start + max_chars;

        if (lines.items.len == 2 and end < text.len) {
            try lines.append(arena, try truncate(arena, text[start..], max_chars));
            break;
        }

        try lines.append(arena, text[start..end]);
        start = end;
        while (start < text.len and text[start] == ' ') : (start += 1) {}
    }
    return lines.items;
}

fn stripTrailingEmoji(text: []const u8) []const u8 {
    var end = text.len;
    while (end > 0 and (text[end - 1] == ' ' or text[end - 1] > 0x7f)) : (end -= 1) {}
    return if (end == 0) text else text[0..end];
}

fn truncate(arena: std.mem.Allocator, text: []const u8, max: usize) ![]const u8 {
    if (text.len <= max) return text;
    var end = max;
    while (end > 0 and text[end - 1] != ' ') : (end -= 1) {}
    if (end < max / 2) end = max;
    if (end > 0 and text[end - 1] == ' ') end -= 1;
    return arena.print("{s}…", .{text[0..end]});
}

const tagline: []const []const u8 = &.{
    "Building high quality software for companies and",
    "crafting Ziex, a full-stack web framework for Zig.",
};

const home: Props = .{ .path = "home", .title = "Nurul Huda (Apon)", .subtitle = tagline };

const pages = [_]Props{
    home,
    .{ .path = "about", .title = "About", .subtitle = tagline },
    .{ .path = "blog", .title = "Blog", .subtitle = &.{"Writing and notes from Nurul Huda (Apon)"} },
    .{ .path = "schedule", .title = "Schedule", .subtitle = &.{"Pick a time that works for you and let's talk"} },
    .{ .path = "ask", .title = "Ask Me Anything", .subtitle = &.{"Anonymously ask me anything"} },
};

fn staticParams(ctx: *zx.StaticContext) !void {
    try ctx.params.add(.{ .@"*" = "avatar.png" });
    inline for (pages) |page| {
        try ctx.params.add(.{ .@"*" = page.path ++ ".png" });
    }
    for (posts.list(ctx.arena, ctx.io) catch &.{}) |post| {
        try ctx.params.add(.{ .@"*" = try ctx.arena.print("blog/{s}.png", .{post.slug}) });
    }
}

pub const options = zx.RouteOptions{
    .rendering = .prerendered,
    .static = staticParams,
};

const Card = @import("template.zx").Card;
const Props = @import("template.zx").Props;
const avatar = @import("../../../avatar.zig");
const posts = @import("../../../blog.zig").posts;

const geist_fonts = @import("geist_fonts");
const lunasvg = @import("lunasvg");
const zx = @import("zx");
const std = @import("std");
