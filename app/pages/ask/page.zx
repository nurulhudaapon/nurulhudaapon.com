pub fn Page(ctx: zx.PageContext) !zx.Component {
    ctx.data.set("title", "Ask Me Anything - Nurul Huda (Apon)");
    ctx.data.set("description", "Anonymously ask me anything. I'll answer on social media or when you revisit this page.");
    const visitor_id = visitorId(ctx);
    // List before marking seen so this visit still shows the "New Answer!" badge.
    const questions = try db.forVisitor(ctx.arena, visitor_id);
    try db.markSeen(visitor_id);
    const proof = spam.proof(visitor_id, std.Io.Timestamp.now(ctx.io, .real).toSeconds());

    return (
        <main @allocator={ctx.arena} class="page-inner page-ask">
            <div class="page-inner-content">
                <div class="page-nav">
                    <Navbar />
                </div>

                <div class="ask-content">
                    <h1 class="ask-title">Ask Me Anything</h1>
                    <p class="ask-intro">
                        Anonymously ask me anything. I'll answer it in my social media or you can find the answer by revisiting this page.
                    </p>

                    <AskForm @client proof={proof} questions={questions} />
                </div>
            </div>
        </main>
    );
}

fn visitorId(ctx: zx.PageContext) []const u8 {
    if (form.visitorCookie(ctx.request)) |id| return id;
    const seed: u64 = @intCast(@divTrunc(std.Io.Timestamp.now(ctx.io, .awake).nanoseconds, 1000));
    var prng = std.Random.DefaultPrng.init(seed);
    const id = ctx.fmt("{x}", .{prng.random().int(u64)}) catch "anon";
    ctx.response.cookies.set(form.visitor_cookie, id, .{
        .path = "/",
        .max_age = .fromSeconds(60 * 60 * 24 * 365),
        .http_only = true,
        .same_site = .lax,
    });
    return id;
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const Navbar = @import("../component.zx").Navbar;
pub const AskForm = form.AskForm;
const form = @import("form.zx");
const db = @import("db.zig");
const spam = @import("../spam.zig");

const zx = @import("zx");
const std = @import("std");
