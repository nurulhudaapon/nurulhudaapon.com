pub fn Page(ctx: zx.PageContext) !zx.Component {
    const unanswered = try questions.list(ctx.arena, .unanswered);
    booking.syncUpcoming(ctx.arena, ctx.io);
    const now = std.Io.Timestamp.now(ctx.io, .real).toSeconds();
    const upcoming = try booking.list(ctx.arena, .upcoming, 5, now);
    const counts = booking.counts(ctx.arena, now);

    return (
        <div @allocator={ctx.arena} class="adm-home">
            <h1 class="adm-home-title">What needs you today?</h1>

            <div class="adm-home-glance">
                <NetWorthGlance @client />
                <a class="adm-glance" href="/admin/questions">
                    <span class="adm-glance-label">Unanswered</span>
                    <span class="adm-glance-value">{unanswered.len}</span>
                    <span class="adm-glance-sub">Questions from /ask</span>
                </a>
                <a class="adm-glance" href="/admin/bookings">
                    <span class="adm-glance-label">Upcoming</span>
                    <span class="adm-glance-value">{counts.upcoming}</span>
                    <span class="adm-glance-sub">Bookings on /schedule</span>
                </a>
            </div>

            <div class="adm-columns">
                <section class="adm-column">
                    <a class="adm-column-head" href="/admin/questions">
                        <span>Unanswered</span>
                        <span class="adm-pill">{unanswered.len}</span>
                        {ui.icon(ctx.arena, .chevron_right)}
                    </a>
                    {if (unanswered.len == 0) (
                        <ui.Empty text="Inbox zero." />
                    )}
                    {for (unanswered[0..@min(unanswered.len, 5)]) |q| (
                        <a class="adm-row" href="/admin/questions">
                            {ui.icon(ctx.arena, .question)}
                            <span class="adm-row-main">
                                <span class="adm-row-title">{q.question}</span>
                                <span class="adm-row-sub">{format.ago(ctx.arena, now, q.created_at)}</span>
                            </span>
                            {ui.icon(ctx.arena, .chevron_right)}
                        </a>
                    )}
                </section>

                <section class="adm-column">
                    <a class="adm-column-head" href="/admin/bookings">
                        <span>Upcoming</span>
                        <span class="adm-pill">{counts.upcoming}</span>
                        {ui.icon(ctx.arena, .chevron_right)}
                    </a>
                    {if (upcoming.len == 0) (
                        <ui.Empty text="No meetings booked." />
                    )}
                    {for (upcoming) |b| (
                        <a class="adm-row" href="/admin/bookings">
                            {ui.icon(ctx.arena, .calendar)}
                            <span class="adm-row-main">
                                <span class="adm-row-title">{b.name}</span>
                                <span class="adm-row-sub">{format.date(ctx.arena, b.starts_at)} · {format.timeRange(ctx.arena, b.starts_at, b.ends_at)}</span>
                            </span>
                            <span class="adm-row-aside">{format.until(ctx.arena, now, b.starts_at)}</span>
                        </a>
                    )}
                </section>

            </div>
        </div>
    );
}

const Peek = struct {
    amount: []const u8 = "",
    account_count: usize = 0,
    visible: bool = false,
};

pub fn NetWorthGlance(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    const peek = ctx.state(Peek, .{});
    autohide.target = peek;
    const load = ctx.action(loadNetWorth, .{ .on_settle = autohide.schedule });
    const alloc = ctx.allocator;
    const state = peek.get();
    const has_amount = state.amount.len > 0;

    return (
        <div @allocator={alloc} class="adm-glance">
            <div class="adm-glance-label-row">
                <span class="adm-glance-label">Net worth</span>
                {if (state.visible) (
                    <button
                        type="button"
                        class="adm-glance-peek"
                        onclick={ctx.bind(hide)}
                        title="Hide balance"
                        aria-label="Hide balance"
                        aria-pressed="true"
                    >
                        {ui.icon(alloc, .eye_off)}
                    </button>
                ) else (
                    <form action={load} class="adm-inline">
                        <button
                            type="submit"
                            class="adm-glance-peek"
                            disabled={load.pending}
                            title="Show balance for a few seconds"
                            aria-label="Show balance for a few seconds"
                            aria-pressed="false"
                        >
                            {ui.icon(alloc, if (load.pending) .refresh else .eye)}
                        </button>
                    </form>
                )}
            </div>
            <span class={if (state.visible) "adm-glance-value" else "adm-glance-value adm-glance-value-masked"}>
                {if (state.visible and has_amount) state.amount else "••••••"}
            </span>
            <a class="adm-glance-sub" href="/admin/finance">
                {if (has_amount) (
                    <span>{state.account_count} accounts · Open portfolio</span>
                ) else (
                    <span>Open portfolio</span>
                )}
            </a>
        </div>
    );
}

fn loadNetWorth(a: *zx.server.Action.Stateful) void {
    const peek = a.state(Peek);
    const summary = finance.portfolio.summary(a.inner.arena) catch return peek.set(.{});
    peek.set(.{
        .amount = finance.format.money(a.inner.arena, summary.net_worth, "USD"),
        .account_count = summary.account_count,
        .visible = true,
    });
}

fn hide(e: *zx.client.Event.Stateful) void {
    const peek = e.state(Peek);
    var next = peek.get();
    next.visible = false;
    peek.set(next);
    autohide.pending = 0;
}

// Each reveal starts a timer; only the last one still running hides the amount.
const autohide = struct {
    var target: ?*zx.State(Peek) = null;
    var pending: u32 = 0;

    const delay_ms = 4000;

    fn schedule(outcome: zx.ActionHandle.Outcome) void {
        if (outcome != .ok) return;
        pending += 1;
        _ = zx.client.setTimeout(run, .fromMilliseconds(delay_ms));
    }

    fn run() void {
        pending -|= 1;
        if (pending != 0) return;
        const peek = target orelse return;
        var next = peek.get();
        if (!next.visible) return;
        next.visible = false;
        peek.set(next);
    }
};

pub const options: zx.PageOptions = .{
    .rendering = .request,
    .methods = &.{.POST},
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("ui.zx");
const format = @import("format.zig");
const questions = @import("../../ask.zig");
const booking = @import("../../schedule.zig").booking;
const finance = @import("../../finance.zig");
