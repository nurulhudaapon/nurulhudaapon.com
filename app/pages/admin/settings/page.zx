pub fn Page(ctx: zx.PageContext, _: void, owner: ?Auth.Account) !zx.Component {
    if (ctx.request.method == .POST) {
        const flag = save(ctx) catch |err| switch (err) {
            error.InvalidUrl => "err=bad_url",
            error.InvalidTtl => "err=bad_ttl",
            else => blk: {
                zx.log.err("admin: saving settings failed: {any}", .{err});
                break :blk "err=failed";
            },
        };
        return ui.redirect(ctx, try ctx.fmt("/admin/settings?{s}", .{flag}));
    }

    const caldav = credentials.CaldavForm.load(ctx.arena);
    const ibkr = credentials.IbkrForm.load(ctx.arena);
    const github_set = credentials.githubTokenSet(ctx.arena);
    const mcp_set = credentials.mcpTokenSet(ctx.arena);
    const mcp_ttl_days = try ctx.fmt("{d}", .{credentials.mcpTokenTtlDays(ctx.arena)});
    const keys = try passkeyRows(ctx.arena, if (owner) |o| try (try adapter.of(ctx)).passkeys(ctx.arena, o) else &.{});
    const flash = ui.flashFrom(ctx.request.query, &.{
        .{ "saved", "Credentials saved. They’re stored in the database and used on the next request." },
        .{ "cleared", "Selected secrets were cleared." },
        .{ "bad_url", "URLs must start with https:// or http://." },
        .{ "bad_ttl", "MCP token lifetime must be between 1 and 365 days." },
        .{ "failed", "Something went wrong. Check the server logs." },
        .{ "passkey_added", "Passkey added. You can now sign in with it." },
        .{ "passkey_removed", "Passkey removed." },
        .{ "passkey", "The passkey couldn't be added. Try again." },
        .{ "expired", "Adding the passkey took too long. Try again." },
        .{ "passkey_exists", "This device already has a passkey here." },
    });

    return (
        <div @allocator={ctx.arena}>
            <ui.PageHeader title="Settings" description="Integration credentials. Leave a secret blank to keep the current value." />
            <ui.FlashBanner flash={flash} />

            {if (owner != null) (
                <section class="adm-card adm-settings" style="margin-bottom:1rem">
                    <div class="adm-settings-row">
                        <div>
                            <p class="adm-label">Passkeys</p>
                            <p class="adm-hint">Sign in with Touch ID, Face ID, Windows Hello or a security key instead of GitHub. Each passkey stays tied to the GitHub account that added it, and stops working if that account is removed from the allowed list.</p>
                        </div>
                        <div class="adm-stack-fields">
                            {for (keys) |k| (
                                <form method="post" action="/auth/passkey/remove" class="adm-passkey">
                                    <div>
                                        <p class="adm-item-title">{k.name}</p>
                                        <p class="adm-hint">{k.meta}</p>
                                    </div>
                                    <input type="hidden" name="credential_id" value={k.id} />
                                    <button class="adm-btn adm-btn-danger" type="submit">Remove</button>
                                </form>
                            )}
                            <div class="adm-field">
                                <label class="adm-label" for="passkey_name">Name</label>
                                <input class="adm-input" id="passkey_name" maxlength="60" autocomplete="off" placeholder="e.g. MacBook Touch ID" />
                            </div>
                            <div>
                                <button
                                    type="button"
                                    class="adm-btn adm-btn-primary"
                                    data-passkey="register"
                                    data-options="/auth/passkey/register/options"
                                    data-verify="/auth/passkey/register"
                                    data-name="passkey_name"
                                    data-error="/admin/settings?err=passkey"
                                    data-exists="/admin/settings?err=passkey_exists"
                                >
                                    Add a passkey
                                </button>
                            </div>
                        </div>
                    </div>
                    <passkey_ui.Script />
                </section>
            )}

            <form method="post" action="/admin/settings" class="adm-card adm-settings" style="margin-bottom:1rem">
                <div class="adm-settings-row">
                    <div>
                        <p class="adm-label">IBKR Flex</p>
                        <p class="adm-hint">Read-only Flex Web Service. Activity Flex Query must include Open Positions, Equity Summary, and Cash Report (XML, all sub-accounts) in Client Portal → Reporting → Flex Queries. Without Cash Report / Equity Summary, brokerage cash stays at 0.</p>
                    </div>
                    <div class="adm-stack-fields">
                        <div class="adm-field">
                            <label class="adm-label" for="ibkr_flex_token">Access token</label>
                            <input class="adm-input" id="ibkr_flex_token" type="password" name="ibkr_flex_token" autocomplete="off" placeholder={if (ibkr.token_set) "•••••••• (saved - leave blank to keep)" else "Flex Web Service token"} />
                        </div>
                        <div class="adm-field">
                            <label class="adm-label" for="ibkr_flex_query_id">Query ID</label>
                            <input class="adm-input" id="ibkr_flex_query_id" name="ibkr_flex_query_id" value={ibkr.query_id} placeholder="e.g. 123456" />
                        </div>
                        <label class="adm-check">
                            <input type="checkbox" name="clear_ibkr_token" value="on" />
                            <span>Clear saved IBKR token</span>
                        </label>
                    </div>
                </div>

                <div class="adm-settings-row">
                    <div>
                        <p class="adm-label">CalDAV (iCloud)</p>
                        <p class="adm-hint">Used by /schedule for busy times and booking invites.</p>
                    </div>
                    <div class="adm-stack-fields">
                        <div class="adm-field">
                            <label class="adm-label" for="caldav_username">Apple ID / username</label>
                            <input class="adm-input" id="caldav_username" name="caldav_username" value={caldav.username} autocomplete="username" />
                        </div>
                        <div class="adm-field">
                            <label class="adm-label" for="caldav_password">App-specific password</label>
                            <input class="adm-input" id="caldav_password" type="password" name="caldav_password" autocomplete="new-password" placeholder={if (caldav.password_set) "•••••••• (saved - leave blank to keep)" else "App-specific password"} />
                        </div>
                        <div class="adm-field">
                            <label class="adm-label" for="caldav_calendar_url">Calendar URL</label>
                            <input class="adm-input" id="caldav_calendar_url" name="caldav_calendar_url" value={caldav.calendar_url} placeholder="https://…caldav…/calendars/…" />
                        </div>
                        <div class="adm-field">
                            <label class="adm-label" for="caldav_organizer_email">Organizer email</label>
                            <input class="adm-input" id="caldav_organizer_email" type="email" name="caldav_organizer_email" value={caldav.organizer_email} />
                        </div>
                        <div class="adm-field">
                            <label class="adm-label" for="caldav_meeting_url">Default meeting link</label>
                            <input class="adm-input" id="caldav_meeting_url" type="url" name="caldav_meeting_url" value={caldav.meeting_url} placeholder="https://meet.google.com/…" />
                        </div>
                        <label class="adm-check">
                            <input type="checkbox" name="clear_caldav_password" value="on" />
                            <span>Clear saved CalDAV password</span>
                        </label>
                    </div>
                </div>

                <div class="adm-settings-row">
                    <div>
                        <p class="adm-label">GitHub</p>
                        <p class="adm-hint">Optional. Raises API rate limits for /dev pinned repos.</p>
                    </div>
                    <div class="adm-stack-fields">
                        <div class="adm-field">
                            <label class="adm-label" for="github_token">Personal access token</label>
                            <input class="adm-input" id="github_token" type="password" name="github_token" autocomplete="off" placeholder={if (github_set) "•••••••• (saved - leave blank to keep)" else "ghp_…"} />
                        </div>
                        <label class="adm-check">
                            <input type="checkbox" name="clear_github_token" value="on" />
                            <span>Clear saved GitHub token</span>
                        </label>
                    </div>
                </div>

                <div class="adm-settings-row">
                    <div>
                        <p class="adm-label">MCP</p>
                        <p class="adm-hint">Enables MCP. Clearing the secret disables <code>/mcp</code> (including previously approved client tokens). Clients OAuth through <a href="/admin/mcp">MCP consent</a> (Zero Trust).</p>
                    </div>
                    <div class="adm-stack-fields">
                        <div class="adm-field">
                            <label class="adm-label" for="mcp_token">Enablement secret</label>
                            <input class="adm-input" id="mcp_token" type="password" name="mcp_token" autocomplete="off" placeholder={if (mcp_set) "•••••••• (saved - leave blank to keep)" else "mcp_…"} />
                        </div>
                        <div class="adm-field">
                            <label class="adm-label" for="mcp_token_ttl_days">Access token lifetime (days)</label>
                            <input class="adm-input" id="mcp_token_ttl_days" type="number" name="mcp_token_ttl_days" min="1" max="365" step="1" value={mcp_ttl_days} />
                        </div>
                        <label class="adm-check">
                            <input type="checkbox" name="clear_mcp_token" value="on" />
                            <span>Disable MCP (clear secret)</span>
                        </label>
                    </div>
                </div>

                <div class="adm-settings-foot">
                    <a class="adm-btn adm-btn-ghost" href="/admin/settings">Discard</a>
                    <button class="adm-btn adm-btn-primary" type="submit" name="action" value="save">Save credentials</button>
                </div>
            </form>
        </div>
    );
}

const PasskeyRow = struct { id: []const u8, name: []const u8, meta: []const u8 };

fn passkeyRows(arena: std.mem.Allocator, keys: []const Auth.Passkey) ![]const PasskeyRow {
    const rows = try arena.alloc(PasskeyRow, keys.len);
    for (rows, keys) |*row, k| row.* = .{
        .id = k.id,
        .name = k.name,
        .meta = if (k.last_used_at) |used|
            try arena.print("Added {s} · last used {s}", .{ format.date(arena, k.created_at), format.date(arena, used) })
        else
            try arena.print("Added {s} · never used", .{format.date(arena, k.created_at)}),
    };
    return rows;
}

fn save(ctx: zx.PageContext) ![]const u8 {
    const fd = ctx.request.formData();
    var cleared = false;

    if (try saveSecret(fd, "ibkr_flex_token", "clear_ibkr_token")) cleared = true;
    try credentials.put("ibkr_flex_query_id", field(fd, "ibkr_flex_query_id"));

    try credentials.putUnlessEmpty("caldav_username", fd.get("caldav_username") orelse "");
    if (try saveSecret(fd, "caldav_password", "clear_caldav_password")) cleared = true;
    try credentials.putUnlessEmpty("caldav_calendar_url", fd.get("caldav_calendar_url") orelse "");
    try credentials.putUnlessEmpty("caldav_organizer_email", fd.get("caldav_organizer_email") orelse "");

    const meeting = field(fd, "caldav_meeting_url");
    if (meeting.len > 0 and !settings.isHttpUrl(meeting)) return error.InvalidUrl;
    try credentials.put("caldav_meeting_url", meeting);

    if (try saveSecret(fd, "github_token", "clear_github_token")) cleared = true;
    if (try saveSecret(fd, "mcp_token", "clear_mcp_token")) cleared = true;

    const ttl = field(fd, "mcp_token_ttl_days");
    if (ttl.len > 0) {
        const days = std.fmt.parseInt(u32, ttl, 10) catch return error.InvalidTtl;
        if (days < 1 or days > credentials.mcp_token_ttl_days_max) return error.InvalidTtl;
        try credentials.put("mcp_token_ttl_days", try ctx.arena.print("{d}", .{days}));
    }

    credentials.apply(ctx.arena);
    return if (cleared) "ok=cleared" else "ok=saved";
}

// A blank secret keeps the saved one. Returns whether it was cleared.
fn saveSecret(fd: anytype, key: []const u8, clear: []const u8) !bool {
    if (fd.get(clear) != null) {
        try credentials.remove(key);
        return true;
    }
    try credentials.putUnlessEmpty(key, fd.get(key) orelse "");
    return false;
}

fn field(fd: anytype, name: []const u8) []const u8 {
    return std.mem.trim(u8, fd.get(name) orelse "", " \t\r\n");
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../ui.zx");
const credentials = @import("../../../db/credentials.zig");
const settings = @import("../../../schedule.zig").settings;
const format = @import("../format.zig");
const adapter = @import("../../../auth/adapter.zig");
const Auth = @import("auth");
const passkey_ui = @import("../../auth/passkey.zx");
