pub fn Layout(ctx: zx.LayoutContext, children: zx.Component, _: void, signed_in: ?Auth.Account) zx.Component {
    const path = ctx.request.pathname;
    const user = if (signed_in) |s| s.name else "local";

    return (
        <div @allocator={ctx.arena} class="adm">
            <input type="checkbox" id="adm-nav-toggle" class="adm-nav-toggle" aria-hidden="true" />
            <aside class="adm-sidebar">
                <a class="adm-account" href="/admin" title="Overview">
                    <img class="adm-account-avatar" src="/og/avatar.png" alt="" width="28" height="28" />
                    <span class="adm-account-name">Nurul Huda (Apon)</span>
                </a>
                <nav class="adm-nav" aria-label="Admin">
                    <NavItem href="/admin" label="Overview" kind={.home} active={std.mem.eql(u8, path, "/admin")} />

                    <p class="adm-nav-section">Inbox</p>
                    <NavItem href="/admin/questions" label="Questions" kind={.question} active={isUnder(path, "/admin/questions")} badge={.unanswered} />

                    <p class="adm-nav-section">Schedule</p>
                    <NavItem href="/admin/bookings" label="Bookings" kind={.calendar} active={isUnder(path, "/admin/bookings")} badge={.upcoming} />
                    <NavItem href="/admin/availability" label="Availability" kind={.clock} active={isUnder(path, "/admin/availability")} />

                    <p class="adm-nav-section">Finance</p>
                    <NavItem href="/admin/finance" label="Portfolio" kind={.chart} active={std.mem.eql(u8, path, "/admin/finance")} />
                    <NavItem href="/admin/finance/accounts" label="Accounts" kind={.wallet} active={isUnder(path, "/admin/finance/accounts")} />
                    <NavItem href="/admin/finance/allocation" label="Allocation" kind={.pie} active={isUnder(path, "/admin/finance/allocation")} />

                    <p class="adm-nav-section">Content</p>
                    <NavItem href="/admin/posts" label="Posts" kind={.file} active={isUnder(path, "/admin/posts")} />
                </nav>
                <div class="adm-sidebar-foot">
                    <NavItem href="/admin/settings" label="Settings" kind={.settings} active={isUnder(path, "/admin/settings")} />
                    <a class="adm-nav-icon" href="/" target="_blank" rel="noopener" title="View site" aria-label="View site">
                        {ui.icon(ctx.arena, .external)}
                    </a>
                </div>
            </aside>
            <label class="adm-scrim" for="adm-nav-toggle" aria-hidden="true"></label>
            <div class="adm-main">
                <header class="adm-topbar">
                    <label class="adm-menu-btn" for="adm-nav-toggle" aria-label="Toggle navigation">
                        {ui.icon(ctx.arena, .menu)}
                    </label>
                    <span class="adm-topbar-crumb">{crumb(path)}</span>
                    <div class="adm-topbar-right">
                        <a class="adm-topbar-link" href="/ask" target="_blank" rel="noopener" title="Open /ask">Ask</a>
                        <a class="adm-topbar-link" href="/schedule" target="_blank" rel="noopener" title="Open /schedule">Schedule</a>
                        <span class="adm-user" title={user}>
                            {ui.icon(ctx.arena, .user)}
                        </span>
                        {if (signed_in != null) (
                            <form method="post" action="/auth/logout" class="adm-inline">
                                <button class="adm-topbar-link adm-link-button" type="submit">Sign out</button>
                            </form>
                        )}
                    </div>
                </header>
                <main class="adm-content">
                    {children}
                </main>
            </div>
        </div>
    );
}

fn NavItem(allocator: zx.Allocator, props: struct {
    href: []const u8,
    label: []const u8,
    kind: ui.Icon,
    active: bool,
    badge: ?BadgeKind = null,
}) zx.Component {
    return (
        <a @{allocator} class={if (props.active) "adm-nav-item adm-nav-item-active" else "adm-nav-item"} href={props.href}>
            {ui.icon(allocator, props.kind)}
            <span>{props.label}</span>
            {if (props.badge) |kind| (
                <NavBadge @client kind={kind} />
            )}
        </a>
    );
}

const BadgeKind = enum { unanswered, upcoming };

pub fn NavBadge(ctx: *zx.ComponentCtx(struct { kind: BadgeKind })) zx.Component {
    const count = ctx.state(i64, 0);
    if (comptime zx.platform.role == .client) badge_feed.watch(ctx.props.kind, count);

    const n = count.get();
    return (
        <span @allocator={ctx.allocator} class="adm-nav-badge" hidden={n <= 0}>{n}</span>
    );
}

const badge_feed = struct {
    const Watcher = struct { kind: BadgeKind, count: *zx.State(i64) };

    var watchers: [4]Watcher = undefined;
    var len: usize = 0;
    var requested = false;

    fn watch(kind: BadgeKind, count: *zx.State(i64)) void {
        for (watchers[0..len]) |w| if (w.count == count) return;
        if (len == watchers.len) return;
        watchers[len] = .{ .kind = kind, .count = count };
        len += 1;

        if (requested) return;
        requested = true;
        var client: zx.http.Client = .{ .io = zx.Io.default(), .allocator = zx.allocator };
        defer client.deinit();
        client.fetchThen(.{ .url = "/admin/badges" }, {}, onLoad);
    }

    fn onLoad(_: void, result: zx.http.Client.Error!zx.http.Client.Result) void {
        const res = result catch {
            requested = false;
            return;
        };
        if (res.status.class() != .success) return;

        const counts = zx.util.zxon.parse(badges.Counts, zx.allocator, res.body, .{}) catch return;

        for (watchers[0..len]) |w| w.count.set(switch (w.kind) {
            .unanswered => counts.unanswered,
            .upcoming => counts.upcoming,
        });
    }
};

fn isUnder(path: []const u8, prefix: []const u8) bool {
    if (!std.mem.startsWith(u8, path, prefix)) return false;
    return path.len == prefix.len or path[prefix.len] == '/';
}

fn crumb(path: []const u8) []const u8 {
    if (isUnder(path, "/admin/questions")) return "Inbox / Questions";
    if (isUnder(path, "/admin/bookings")) return "Schedule / Bookings";
    if (isUnder(path, "/admin/availability")) return "Schedule / Availability";
    if (isUnder(path, "/admin/finance/accounts")) return "Finance / Accounts";
    if (isUnder(path, "/admin/finance/allocation")) return "Finance / Allocation";
    if (isUnder(path, "/admin/finance/zakat")) return "Finance / Zakat";
    if (isUnder(path, "/admin/finance/rates")) return "Finance / Rates";
    if (isUnder(path, "/admin/finance")) return "Finance / Portfolio";
    if (isUnder(path, "/admin/posts")) return "Content / Posts";
    if (isUnder(path, "/admin/mcp")) return "MCP";
    if (isUnder(path, "/admin/settings")) return "Settings";
    return "Overview";
}

const std = @import("std");
const zx = @import("zx");
const ui = @import("ui.zx");
const badges = @import("badges/route.zig");
const Auth = @import("auth");
