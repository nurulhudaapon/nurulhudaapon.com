pub const Icon = enum { home, question, calendar, clock, file, external, chevron_right, chevrons, menu, more, user, video, arrow_left, chart, settings, wallet, pie, percent, heart, eye, eye_off, refresh };

pub const FinancePage = enum { portfolio, accounts, allocation, zakat, rates };

