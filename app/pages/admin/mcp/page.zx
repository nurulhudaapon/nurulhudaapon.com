pub fn Page(ctx: zx.PageContext) !zx.Component {
    if (ctx.request.method == .POST) {
        return handlePost(ctx);
    }

    const q = ctx.request.queries;
    const client_id = q.get("client_id") orelse "";
    const redirect_uri = q.get("redirect_uri") orelse "";
    const scope = q.get("scope") orelse "mcp";
    const state = q.get("state") orelse "";
    const resource = q.get("resource") orelse "";
    const has_request = client_id.len > 0 and redirect_uri.len > 0;

    const flash = ui.flashFrom(ctx.request.queries, &.{
        .{ "denied", "Access denied. The MCP client was not authorized." },
        .{ "missing", "No pending MCP authorization request. Start from an MCP client." },
        .{ "failed", "Something went wrong issuing the authorization code." },
        .{ "no_token", "Enable MCP under Settings before approving clients." },
        .{ "no_access", "Sign in to approve MCP clients." },
        .{ "no_pkce", "MCP clients must use PKCE (S256)." },
    });

    return (
        <div @allocator={ctx.arena}>
            <ui.PageHeader title="MCP consent" description="Approve an MCP client. Cloudflare Access already authenticated you." />
            <ui.FlashBanner flash={flash} />

            {if (!has_request) (
                <div class="adm-card">
                    <ui.Empty text="No pending authorization. When a client connects to /mcp, you’ll land here to approve it." />
                    <p class="adm-hint" style="margin-top:1rem">
                        Enable MCP under <a href="/admin/settings">Settings</a> first. Endpoint: <code>/mcp</code>
                    </p>
                </div>
            ) else (
                <form method="post" action="/admin/mcp" class="adm-card adm-settings">
                    <input type="hidden" name="client_id" value={client_id} />
                    <input type="hidden" name="redirect_uri" value={redirect_uri} />
                    <input type="hidden" name="state" value={state} />
                    <input type="hidden" name="scope" value={scope} />
                    <input type="hidden" name="resource" value={resource} />
                    <input type="hidden" name="code_challenge" value={q.get("code_challenge") orelse ""} />
                    <input type="hidden" name="code_challenge_method" value={q.get("code_challenge_method") orelse ""} />

                    <div class="adm-settings-row">
                        <div>
                            <p class="adm-label">Client</p>
                            <p class="adm-hint">This MCP client is requesting access to your site’s MCP server.</p>
                        </div>
                        <div class="adm-stack-fields">
                            <div class="adm-field">
                                <span class="adm-label">client_id</span>
                                <p class="adm-hint"><code>{client_id}</code></p>
                            </div>
                            <div class="adm-field">
                                <span class="adm-label">redirect_uri</span>
                                <p class="adm-hint"><code>{redirect_uri}</code></p>
                            </div>
                            <div class="adm-field">
                                <span class="adm-label">scope</span>
                                <p class="adm-hint"><code>{scope}</code></p>
                            </div>
                            {if (resource.len > 0) (
                                <div class="adm-field">
                                    <span class="adm-label">resource</span>
                                    <p class="adm-hint"><code>{resource}</code></p>
                                </div>
                            )}
                        </div>
                    </div>

                    <div class="adm-settings-foot">
                        <button class="adm-btn adm-btn-ghost" type="submit" name="action" value="deny">Deny</button>
                        <button class="adm-btn adm-btn-primary" type="submit" name="action" value="approve">Approve</button>
                    </div>
                </form>
            )}
        </div>
    );
}

fn handlePost(ctx: zx.PageContext) !zx.Component {
    const fd = ctx.request.formData();
    const action = fd.get("action") orelse "";
    const redirect_uri = fd.get("redirect_uri") orelse "";
    const state = fd.get("state") orelse "";

    if (std.mem.eql(u8, action, "deny")) {
        if (redirect_uri.len == 0) return ui.redirect(ctx, "/admin/mcp?ok=denied");
        const loc = try appendQuery(ctx.arena, redirect_uri, &.{
            .{ "error", "access_denied" },
            .{ "state", state },
        });
        return ui.redirect(ctx, loc);
    }

    if (!std.mem.eql(u8, action, "approve")) {
        return ui.redirect(ctx, "/admin/mcp?err=missing");
    }

    if (store.mcpSecret(ctx.arena) == null) {
        return ui.redirect(ctx, "/admin/mcp?err=no_token");
    }

    const client_id = fd.get("client_id") orelse "";
    if (client_id.len == 0 or redirect_uri.len == 0) {
        return ui.redirect(ctx, "/admin/mcp?err=missing");
    }

    const challenge = fd.get("code_challenge") orelse "";
    const method = fd.get("code_challenge_method") orelse "";
    if (challenge.len == 0 or !std.mem.eql(u8, method, "S256")) {
        return ui.redirect(ctx, "/admin/mcp?err=no_pkce");
    }

    const owner = adapter.account(ctx) orelse return ui.redirect(ctx, "/admin/mcp?err=no_access");
    const user = try ctx.fmt("{s}:{s}", .{ owner.provider, owner.login });

    const code = try store.randomToken(ctx.arena);
    store.insertCode(.{
        .code = code,
        .client_id = client_id,
        .redirect_uri = redirect_uri,
        .code_challenge = challenge,
        .code_challenge_method = method,
        .scope = nonempty(fd.get("scope")),
        .resource = nonempty(fd.get("resource")),
        .state = if (state.len > 0) state else null,
        .approved_by = user,
        .expires_at = booking.nowUnix() + store.code_ttl_secs,
    }) catch {
        return ui.redirect(ctx, "/admin/mcp?err=failed");
    };

    const loc = try appendQuery(ctx.arena, redirect_uri, &.{
        .{ "code", code },
        .{ "state", state },
    });
    return ui.redirect(ctx, loc);
}

fn nonempty(v: ?[]const u8) ?[]const u8 {
    const s = v orelse return null;
    return if (s.len > 0) s else null;
}

fn appendQuery(arena: std.mem.Allocator, base: []const u8, pairs: []const struct { []const u8, []const u8 }) ![]const u8 {
    var aw: std.Io.Writer.Allocating = .init(arena);
    try aw.writer.writeAll(base);
    const sep: u8 = if (std.mem.indexOfScalar(u8, base, '?') != null) '&' else '?';
    try aw.writer.writeByte(sep);
    for (pairs, 0..) |pair, i| {
        if (i > 0) try aw.writer.writeByte('&');
        try aw.writer.writeAll(pair[0]);
        try aw.writer.writeByte('=');
        try urlEncode(&aw.writer, pair[1]);
    }
    return aw.written();
}

fn urlEncode(w: *std.Io.Writer, value: []const u8) !void {
    for (value) |c| switch (c) {
        'A'...'Z', 'a'...'z', '0'...'9', '-', '_', '.', '~' => try w.writeByte(c),
        ' ' => try w.writeAll("%20"),
        else => try w.print("%{X:0>2}", .{c}),
    };
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../ui.zx");
const store = @import("../../../routes/mcp/store.zig");
const booking = @import("../../schedule/booking.zig");
const adapter = @import("../../../auth/adapter.zig");
