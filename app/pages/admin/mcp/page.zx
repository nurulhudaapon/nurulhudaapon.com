pub fn Page(ctx: zx.PageContext, _: void, signed_in: ?Auth.Account) !zx.Component {
    if (ctx.request.method == .POST) return handle(ctx, signed_in);

    const q = ctx.request.query;
    const request = store.endpoint(ctx).authorization(ctx.arena, q) catch null;
    const has_request = request != null;
    const client_id = if (request) |r| r.client.id else "";
    const client_name = if (request) |r| r.client.name orelse "Unnamed client" else "";
    const redirect_uri = if (request) |r| r.redirect_uri else "";
    const scope = if (request) |r| r.scope orelse "mcp" else "mcp";
    const state = if (request) |r| r.state orelse "" else "";
    const resource = if (request) |r| r.resource orelse "" else "";

    const flash = ui.flashFrom(ctx.request.query, &.{
        .{ "denied", "Access denied. The MCP client was not authorized." },
        .{ "missing", "No pending MCP authorization request. Start from an MCP client." },
        .{ "failed", "Something went wrong issuing the authorization code." },
        .{ "no_token", "Enable MCP under Settings before approving clients." },
        .{ "no_access", "Sign in to approve MCP clients." },
        .{ "no_pkce", "MCP clients must use PKCE (S256)." },
    });

    return (
        <div @allocator={ctx.arena}>
            <ui.PageHeader title="MCP consent" description="Approve an MCP client. Cloudflare Access already authenticated you." />
            <ui.FlashBanner flash={flash} />

            {if (!has_request) (
                <div class="adm-card">
                    <ui.Empty text="No pending authorization. When a client connects to /mcp, you’ll land here to approve it." />
                    <p class="adm-hint" style="margin-top:1rem">
                        Enable MCP under <a href="/admin/settings">Settings</a> first. Endpoint: <code>/mcp</code>
                    </p>
                </div>
            ) else (
                <form method="post" action="/admin/mcp" class="adm-card adm-settings">
                    <input type="hidden" name="response_type" value="code" />
                    <input type="hidden" name="client_id" value={client_id} />
                    <input type="hidden" name="redirect_uri" value={redirect_uri} />
                    <input type="hidden" name="state" value={state} />
                    <input type="hidden" name="scope" value={scope} />
                    <input type="hidden" name="resource" value={resource} />
                    <input type="hidden" name="code_challenge" value={q.get("code_challenge") orelse ""} />
                    <input type="hidden" name="code_challenge_method" value={q.get("code_challenge_method") orelse ""} />

                    <div class="adm-settings-row">
                        <div>
                            <p class="adm-label">Client</p>
                            <p class="adm-hint">This MCP client is requesting access to your site’s MCP server.</p>
                        </div>
                        <div class="adm-stack-fields">
                            <div class="adm-field">
                                <span class="adm-label">name</span>
                                <p class="adm-hint">{client_name}</p>
                            </div>
                            <div class="adm-field">
                                <span class="adm-label">client_id</span>
                                <p class="adm-hint"><code>{client_id}</code></p>
                            </div>
                            <div class="adm-field">
                                <span class="adm-label">redirect_uri</span>
                                <p class="adm-hint"><code>{redirect_uri}</code></p>
                            </div>
                            <div class="adm-field">
                                <span class="adm-label">scope</span>
                                <p class="adm-hint"><code>{scope}</code></p>
                            </div>
                            {if (resource.len > 0) (
                                <div class="adm-field">
                                    <span class="adm-label">resource</span>
                                    <p class="adm-hint"><code>{resource}</code></p>
                                </div>
                            )}
                        </div>
                    </div>

                    <div class="adm-settings-foot">
                        <button class="adm-btn adm-btn-ghost" type="submit" name="action" value="deny">Deny</button>
                        <button class="adm-btn adm-btn-primary" type="submit" name="action" value="approve">Approve</button>
                    </div>
                </form>
            )}
        </div>
    );
}

fn handle(ctx: zx.PageContext, signed_in: ?Auth.Account) !zx.Component {
    const fd = ctx.request.formData();
    const action = fd.get("action") orelse "";
    const endpoint = store.endpoint(ctx);
    const request = endpoint.authorization(ctx.arena, fd) catch |err| return ui.redirect(ctx, switch (err) {
        error.PkceRequired => "/admin/mcp?err=no_pkce",
        else => "/admin/mcp?err=missing",
    });

    if (std.mem.eql(u8, action, "deny")) return ui.redirect(ctx, try endpoint.deny(ctx.arena, request));
    if (!std.mem.eql(u8, action, "approve")) return ui.redirect(ctx, "/admin/mcp?err=missing");
    if (!store.enabled(ctx.arena)) return ui.redirect(ctx, "/admin/mcp?err=no_token");

    const owner = signed_in orelse return ui.redirect(ctx, "/admin/mcp?err=no_access");
    const user = try ctx.fmt("{s}:{s}", .{ owner.provider, owner.name });
    const to = endpoint.approve(ctx.arena, request, user) catch return ui.redirect(ctx, "/admin/mcp?err=failed");
    return ui.redirect(ctx, to);
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../ui.zx");
const store = @import("../../../mcp/store.zig");
const Auth = zx.Auth;
