pub fn Page(ctx: zx.PageContext) !zx.Component {
    const slug = ctx.request.params.get("slug") orelse return error.MissingParameter;
    const source = try posts.getSource(ctx.arena, slug);
    const drafts = zx.kv.scoped(.admin_drafts);
    const self_url = try ctx.fmt("/admin/posts/{s}", .{slug});

    var markdown = source.markdown;
    var state: State = .original;
    if (ctx.request.method == .POST) {
        const fd = ctx.request.formData();
        const action = fd.get("action") orelse "save";
        const posted = try std.mem.replaceOwned(u8, ctx.arena, fd.get("markdown") orelse "", "\r\n", "\n");
        if (std.mem.eql(u8, action, "save")) {
            try drafts.put(slug, posted, .{});
            return ui.redirect(ctx, try ctx.fmt("{s}?ok=saved", .{self_url}));
        }
        if (std.mem.eql(u8, action, "discard")) {
            try drafts.delete(slug);
            return ui.redirect(ctx, try ctx.fmt("{s}?ok=discarded", .{self_url}));
        }
        markdown = posted;
        state = .unsaved;
    } else if (try drafts.get(ctx.arena, slug)) |draft| {
        markdown = draft;
        state = .draft;
    }

    const flash = ui.flashFrom(ctx.request.queries, &.{
        .{ "saved", "Draft saved on this site. GitHub is unchanged." },
        .{ "discarded", "Draft discarded. Showing the version from GitHub." },
    });
    const live_url = try ctx.fmt("/blog/{s}", .{slug});

    return (
        <div @allocator={ctx.arena} class="adm-page-fill">
            <a class="adm-back" href="/admin/posts">{ui.icon(ctx.arena, .arrow_left)} All posts</a>
            <ui.FlashBanner flash={flash} />
            <PostEditor
                @client
                self_url={self_url}
                live_url={live_url}
                path={source.path}
                title={source.title}
                draft={source.draft}
                markdown={markdown}
                state={state}
                preview_url={try ctx.fmt("/assets/_/preview.wasm?v={s}", .{&previewVersion()})}
            />
        </div>
    );
}

const State = enum { original, draft, unsaved };

// A new random version per server process (each build or deploy) busts the
// browser's cache of the preview wasm.
var preview_version: ?[16]u8 = null;

fn previewVersion() [16]u8 {
    if (preview_version) |v| return v;
    var bytes: [8]u8 = undefined;
    zx.io().random(&bytes);
    preview_version = std.fmt.bytesToHex(bytes, .lower);
    return preview_version.?;
}

const PreviewState = struct {
    open: bool = false,
    url: []const u8 = "",
    markdown: []const u8 = "",
    title: []const u8 = "",
    html: []const u8 = "",
    minutes: u32 = 0,
};

pub fn PostEditor(ctx: *zx.ComponentCtx(struct {
    self_url: []const u8,
    live_url: []const u8,
    path: []const u8,
    title: []const u8,
    draft: bool,
    markdown: []const u8,
    state: State,
    preview_url: []const u8,
})) zx.Component {
    const preview = ctx.state(PreviewState, .{
        .url = ctx.props.preview_url,
        .markdown = ctx.props.markdown,
        .title = ctx.props.title,
    });
    const alloc = ctx.allocator;
    const p = preview.get();
    const editor_class = if (p.open) "adm-editor adm-editor-split" else "adm-editor adm-editor-focus";

    return (
        <div @allocator={alloc} class="adm-editor-form">
            <form method="post" action={ctx.props.self_url} class="adm-editor-save">
                <div class="adm-editor-bar">
                    <div class="adm-editor-bar-lead">
                        <h1 class="adm-page-title">{ctx.props.title}</h1>
                        <span class={stateClass(ctx.props.state)}>{stateLabel(ctx.props.state)}</span>
                    </div>
                    <div class="adm-page-actions">
                        {if (!ctx.props.draft) (
                            <a class="adm-btn adm-btn-ghost" href={ctx.props.live_url} target="_blank" rel="noopener">
                                View live {ui.icon(alloc, .external)}
                            </a>
                        )}
                        {if (ctx.props.state != .original) (
                            <button class="adm-btn adm-btn-ghost" type="submit" name="action" value="discard" formnovalidate>Discard draft</button>
                        )}
                        <button
                            type="button"
                            class={if (p.open) "adm-btn adm-btn-ghost adm-btn-active" else "adm-btn adm-btn-ghost"}
                            onclick={ctx.bind(togglePreview)}
                            aria-pressed={if (p.open) "true" else "false"}
                        >
                            {if (p.open) "Hide preview" else "Show preview"}
                        </button>
                        <button class="adm-btn adm-btn-primary" type="submit" name="action" value="save">Save draft</button>
                    </div>
                </div>

                <div class={editor_class}>
                    <section class="adm-card adm-pane">
                        <div class="adm-pane-head">
                            <span>Markdown</span>
                            <span class="adm-pane-path">{ctx.props.path}</span>
                        </div>
                        <textarea
                            class="adm-source"
                            name="markdown"
                            spellcheck="true"
                            aria-label="Markdown source"
                            oninput={ctx.bind(updatePreview)}
                        >{ctx.props.markdown}</textarea>
                    </section>

                    {if (p.open) (
                        <section class="adm-card adm-pane">
                            <div class="adm-pane-head">
                                <span>Preview</span>
                                <span>{if (p.minutes > 0) alloc.print("{d} min read", .{p.minutes}) catch "" else ""}</span>
                            </div>
                            <article class="adm-preview">
                                <h1 class="post-title">{p.title}</h1>
                                <div class="post-content" @escaping={.none}>{p.html}</div>
                            </article>
                        </section>
                    )}
                </div>
            </form>
        </div>
    );
}

fn togglePreview(e: *zx.client.Event.Stateful) void {
    const preview = e.state(PreviewState);
    var next = preview.get();
    next.open = !next.open;
    if (next.open) loadPreviewWasm(next.url);
    renderPreview(preview, next, next.markdown);
}

fn updatePreview(e: *zx.client.Event.Stateful) void {
    const preview = e.state(PreviewState);
    renderPreview(preview, preview.get(), e.value() orelse return);
}

// Each render owns an arena; the previous one is freed once state points at the new one.
var preview_arena: ?std.heap.ArenaAllocator = null;

fn renderPreview(preview: anytype, base: PreviewState, markdown: []const u8) void {
    var arena: std.heap.ArenaAllocator = .init(zx.allocator);
    const alloc = arena.allocator();
    var next = base;
    next.markdown = alloc.dupe(u8, markdown) catch return arena.deinit();
    next.title = alloc.dupe(u8, base.title) catch return arena.deinit();
    next.html = alloc.dupe(u8, base.html) catch return arena.deinit();
    if (next.open) if (renderWithWasm(alloc, next.markdown)) |rendered| {
        if (rendered.title.len > 0) next.title = rendered.title;
        next.html = rendered.html;
        next.minutes = rendered.minutes;
    };
    preview.set(next);
    if (preview_arena) |*old| old.deinit();
    preview_arena = arena;
}

const Rendered = struct { title: []const u8, html: []const u8, minutes: u32 };

// Null until the wasm has loaded; the loader then fires `input` on the source to render.
fn renderWithWasm(alloc: std.mem.Allocator, markdown: []const u8) ?Rendered {
    if (comptime zx.platform.role != .client) return null;
    const js = zx.client.js;
    const renderer = js.global.get(js.Object, "__postPreview") catch return null;
    defer renderer.deinit();
    const result = renderer.call(js.Object, "render", .{js.string(markdown)}) catch return null;
    defer result.deinit();
    return .{
        .title = result.getAlloc(js.String, alloc, "title") catch "",
        .html = result.getAlloc(js.String, alloc, "html") catch return null,
        .minutes = result.get(u32, "minutes") catch 0,
    };
}

// Instantiating a wasm module is promise-based, which Zig can't await, so this
// small loader stays in JS. It also moves strings in and out of the module's memory.
const preview_loader =
    \\(url) => {
    \\  if (window.__postPreviewLoading) return;
    \\  window.__postPreviewLoading = true;
    \\  const wasi = { fd_seek: () => 0, fd_write: () => 0, fd_close: () => 0 };
    \\  WebAssembly.instantiateStreaming(fetch(url), { wasi_snapshot_preview1: wasi }).then(({ instance }) => {
    \\    const x = instance.exports;
    \\    x._initialize();
    \\    const read = (ptr, len) => new TextDecoder().decode(new Uint8Array(x.memory.buffer, ptr, len));
    \\    window.__postPreview = {
    \\      render(markdown) {
    \\        const bytes = new TextEncoder().encode(markdown);
    \\        x.preview_reset();
    \\        const ptr = x.preview_alloc(bytes.length);
    \\        new Uint8Array(x.memory.buffer, ptr, bytes.length).set(bytes);
    \\        if (!x.preview_render(ptr, bytes.length)) {
    \\          return { title: "", html: "<p>Couldn't render this markdown. Check the frontmatter block.</p>", minutes: 0 };
    \\        }
    \\        return {
    \\          title: read(x.preview_title_ptr(), x.preview_title_len()),
    \\          html: read(x.preview_html_ptr(), x.preview_html_len()),
    \\          minutes: x.preview_minutes(),
    \\        };
    \\      },
    \\    };
    \\    document.querySelector(".adm-source")?.dispatchEvent(new Event("input", { bubbles: true }));
    \\  }, () => { window.__postPreviewLoading = false; });
    \\}
;

fn loadPreviewWasm(url: []const u8) void {
    const code = zx.allocator.print("({s})(\"{s}\")", .{ preview_loader, url }) catch return;
    defer zx.allocator.free(code);
    _ = zx.client.eval(void, code) catch {};
}

fn stateLabel(state: State) []const u8 {
    return switch (state) {
        .original => "In sync with GitHub",
        .draft => "Saved draft",
        .unsaved => "Unsaved changes",
    };
}

fn stateClass(state: State) []const u8 {
    return switch (state) {
        .original => "adm-badge",
        .draft => "adm-badge adm-badge-ok",
        .unsaved => "adm-badge adm-badge-accent",
    };
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../../ui.zx");
const posts = @import("../../../blog/posts.zig");
