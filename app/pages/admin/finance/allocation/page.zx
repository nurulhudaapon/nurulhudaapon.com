pub fn Page(ctx: zx.PageContext) !zx.Component {
    if (ctx.request.method == .POST) {
        const flag = handle(ctx) catch |err| switch (err) {
            error.InvalidName, error.InvalidPct => "err=invalid",
            else => blk: {
                zx.log.err("admin: finance allocation failed: {any}", .{err});
                break :blk "err=failed";
            },
        };
        return ui.redirect(ctx, try ctx.fmt("/admin/finance/allocation?{s}", .{flag}));
    }

    const targets = try finance.allocations.targets(ctx.arena);
    const data = try finance.portfolio.snapshot(ctx.arena);
    const asset_classes = try finance.classes.list(ctx.arena);
    const flash = ui.flashFrom(ctx.request.query, &.{
        .{ "saved", "Allocation target saved." },
        .{ "deleted", "Allocation target removed." },
        .{ "invalid", "Name is required and target % must be between 0 and 100." },
        .{ "failed", "Something went wrong. Check the server logs." },
    });

    return (
        <div @allocator={ctx.arena}>
            <Header title="Allocation" current={.allocation}>Target weights by asset class.</Header>
            <ui.FlashBanner flash={flash} />

            {if (data.allocations.len > 0) (
                <section class="adm-card adm-card-gap">
                    <div class="adm-section-head">
                        <span>Current vs target</span>
                    </div>
                    <div class="adm-alloc-list adm-alloc-pad">
                        {for (data.allocations) |a| (
                            <div class="adm-alloc-row">
                                <div class="adm-alloc-meta">
                                    <div>
                                        <span class="adm-table-title">{a.name}</span>
                                        <span class="adm-hint">{finance.format.money(ctx.arena, a.actual_value, "USD")}</span>
                                    </div>
                                </div>
                                <div class="adm-bars">
                                    <div class="adm-bar">
                                        <span class="adm-fill" style={shared.barWidth(ctx.arena, a.actual_pct)}></span>
                                    </div>
                                    {if (a.target_pct > 0) (
                                        <div class="adm-bar adm-bar-tgt">
                                            <span class="adm-fill adm-fill-tgt" style={shared.barWidth(ctx.arena, a.target_pct)}></span>
                                        </div>
                                    )}
                                </div>
                                <div class="adm-pcts">
                                    <span>{finance.format.pct(ctx.arena, a.actual_pct)}</span>
                                    {if (a.target_pct > 0) (
                                        <span class="adm-hint">of {finance.format.pct(ctx.arena, a.target_pct)}</span>
                                    )}
                                </div>
                            </div>
                        )}
                    </div>
                </section>
            )}

            <section class="adm-card adm-settings">
                <div class="adm-section-head">
                    <span>Targets</span>
                </div>
                {for (targets) |t| (
                    <form method="post" action="/admin/finance/allocation" class="adm-settings-row">
                        <input type="hidden" name="id" value={t.id} />
                        <div class="adm-field">
                            <label class="adm-label">Class</label>
                            <input class="adm-input" name="name" value={t.name} required />
                        </div>
                        <div class="adm-inline-fields" style="align-items:flex-end">
                            <div class="adm-field">
                                <label class="adm-label">Target %</label>
                                <input class="adm-input" type="number" name="target_pct" min="0" max="100" step="0.1" value={t.target_pct} required />
                            </div>
                            <div class="adm-field" style="flex:1;min-width:8rem">
                                <label class="adm-label">Notes</label>
                                <input class="adm-input" name="notes" value={t.notes orelse ""} />
                            </div>
                            <button class="adm-btn adm-btn-primary" type="submit" name="action" value="save">Save</button>
                            <button class="adm-btn adm-btn-ghost adm-btn-danger" type="submit" name="action" value="delete">Delete</button>
                        </div>
                    </form>
                )}
                <form method="post" action="/admin/finance/allocation" class="adm-settings-row">
                    <input type="hidden" name="id" value="0" />
                    <div class="adm-field">
                        <label class="adm-label">New class</label>
                        <input class="adm-input" name="name" list="asset-classes" required placeholder="e.g. Equities" />
                        <datalist id="asset-classes">
                            {for (asset_classes) |c| (
                                <option value={c.name}></option>
                            )}
                        </datalist>
                    </div>
                    <div class="adm-inline-fields" style="align-items:flex-end">
                        <div class="adm-field">
                            <label class="adm-label">Target %</label>
                            <input class="adm-input" type="number" name="target_pct" min="0" max="100" step="0.1" value="0" required />
                        </div>
                        <div class="adm-field" style="flex:1;min-width:8rem">
                            <label class="adm-label">Notes</label>
                            <input class="adm-input" name="notes" />
                        </div>
                        <button class="adm-btn adm-btn-primary" type="submit" name="action" value="save">Add</button>
                    </div>
                </form>
            </section>
        </div>
    );
}

fn handle(ctx: zx.PageContext) ![]const u8 {
    const fd = ctx.request.formData();
    const action = fd.get("action") orelse return error.InvalidName;
    if (std.mem.eql(u8, action, "delete")) {
        try finance.allocations.delete(try shared.formInt(fd, "id"));
        return "ok=deleted";
    }
    if (std.mem.eql(u8, action, "save")) {
        const pct = std.fmt.parseFloat(f64, fd.get("target_pct") orelse "") catch return error.InvalidPct;
        try finance.allocations.save(ctx.arena, try shared.formInt(fd, "id"), fd.get("name") orelse "", pct, std.mem.trim(u8, fd.get("notes") orelse "", " \t\r\n"));
        return "ok=saved";
    }
    return error.InvalidName;
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../../ui.zx");
const finance = @import("../../../../finance.zig");
const shared = @import("../view.zig");
const Header = @import("../header.zx").Header;
