const top_count = 10;
const skeleton_rows = [_]void{ {}, {}, {} };

pub fn HoldingsPanel(allocator: zx.Allocator, props: struct { loading: bool }) zx.Component {
    if (props.loading) return (<Skeleton @allocator={allocator} />);

    const holdings = finance.holdings.list(allocator, top_count) catch &.{};
    const cash = finance.holdings.cash(allocator) catch &.{};

    return (
        <div @allocator={allocator}>
            {if (holdings.len == 0 and cash.len == 0) (
                <span></span>
            ) else (
                <section class="adm-card">
                    <div class="adm-section-head">
                        <span>Top holdings</span>
                        <span class="adm-hint">{summary(allocator, holdings, cash)}</span>
                    </div>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <Head />
                            <tbody>
                                {for (holdings) |h| (
                                    <tr>
                                        <td class="adm-nowrap">
                                            <a class="adm-table-title adm-link-plain" href={shared.accountHref(allocator, h.account_id)} title={holdingTitle(allocator, h)}>{h.symbol}</a>
                                            <span class="adm-table-sub">{holdingSub(allocator, h)}</span>
                                        </td>
                                        <td class="adm-hide-sm">{h.category}</td>
                                        <PnlCell holding={h} />
                                        <td class="adm-hide-sm">{finance.format.pct(allocator, h.weight_pct)}</td>
                                        <td>{finance.format.money(allocator, h.market_value_base, "USD")}</td>
                                    </tr>
                                )}
                                {for (cash) |c| (
                                    <tr>
                                        <td class="adm-nowrap">
                                            <a class="adm-table-title adm-link-plain" href={shared.accountHref(allocator, c.account_id)} title={c.account_name}>{c.currency}</a>
                                            <span class="adm-table-sub">Cash</span>
                                        </td>
                                        <td class="adm-hide-sm">Cash</td>
                                        <td class="adm-hide-sm">{unsettledLabel(allocator, c)}</td>
                                        <td class="adm-hide-sm">{finance.format.pct(allocator, c.weight_pct)}</td>
                                        <td>{finance.format.money(allocator, c.amount_base, "USD")}</td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </section>
            )}
        </div>
    );
}

fn Skeleton(allocator: zx.Allocator) zx.Component {
    return (
        <div @allocator={allocator}>
            <section class="adm-card">
                <div class="adm-section-head">
                    <span>Top holdings</span>
                    <span class="adm-hint">From IBKR Flex</span>
                </div>
                <div class="adm-table-wrap">
                    <table class="adm-table">
                        <Head />
                        <tbody>
                            {for (skeleton_rows) |_| (
                                <tr>
                                    <td>
                                        <span class="adm-table-title">…</span>
                                        <span class="adm-table-sub">…</span>
                                    </td>
                                    <td class="adm-hide-sm">…</td>
                                    <td class="adm-hide-sm">…</td>
                                    <td class="adm-hide-sm">…</td>
                                    <td>…</td>
                                </tr>
                            )}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    );
}

fn Head(allocator: zx.Allocator) zx.Component {
    return (
        <thead @allocator={allocator}>
            <tr>
                <th>Symbol</th>
                <th class="adm-hide-sm">Class</th>
                <th class="adm-hide-sm">Unrealized P/L</th>
                <th class="adm-hide-sm">Weight</th>
                <th>Value</th>
            </tr>
        </thead>
    );
}

fn summary(arena: zx.Allocator, holdings: []const finance.holdings.Holding, cash: []const finance.holdings.CashBalance) []const u8 {
    var pnl: ?f64 = null;
    for (holdings) |h| if (h.unrealized_pnl_base) |v| {
        pnl = (pnl orelse 0) + v;
    };
    var unsettled: f64 = 0;
    for (cash) |c| unsettled += c.unsettledBase();

    const pnl_part: []const u8 = if (pnl) |v|
        arena.print("P/L {s} · ", .{shared.signedMoney(arena, v, "USD")}) catch ""
    else
        "";
    const unsettled_part: []const u8 = if (@abs(unsettled) >= 0.005)
        arena.print("{s} unsettled · ", .{finance.format.money(arena, unsettled, "USD")}) catch ""
    else
        "";
    return arena.print("{s}{s}From IBKR Flex", .{ pnl_part, unsettled_part }) catch "From IBKR Flex";
}

fn holdingSub(arena: zx.Allocator, h: finance.holdings.Holding) []const u8 {
    return arena.print("{s} × {s}", .{
        finance.format.qty(arena, h.quantity),
        finance.format.money(arena, h.market_price, h.currency),
    }) catch "";
}

fn holdingTitle(arena: zx.Allocator, h: finance.holdings.Holding) []const u8 {
    return arena.print("{s} · {s}", .{ h.description, h.account_name }) catch h.description;
}

fn unsettledLabel(arena: zx.Allocator, c: finance.holdings.CashBalance) []const u8 {
    const amount = c.unsettled();
    if (amount == 0) return "Settled";
    return arena.print("{s} unsettled", .{finance.format.money(arena, amount, c.currency)}) catch "";
}

pub fn PnlCell(allocator: zx.Allocator, props: struct { holding: finance.holdings.Holding }) zx.Component {
    const h = props.holding;
    const pct = pnlPct(allocator, h);
    return (
        <td @allocator={allocator} class={pnlClass(allocator, h.unrealized_pnl_base)}>
            {if (h.unrealized_pnl_base) |pnl| shared.signedMoney(allocator, pnl, "USD") else "-"}
            {if (pct.len > 0) (
                <span class="adm-pnl-pct">{pct}</span>
            )}
        </td>
    );
}

fn pnlPct(arena: zx.Allocator, h: finance.holdings.Holding) []const u8 {
    const pnl = h.unrealized_pnl_base orelse return "";
    const cost = h.cost_basis_base orelse return "";
    if (@abs(cost) < 0.005) return "";
    return shared.signedPct(arena, pnl * 100.0 / @abs(cost));
}

fn pnlClass(arena: zx.Allocator, pnl: ?f64) []const u8 {
    const base = "adm-hide-sm adm-nowrap";
    const v = pnl orelse return base;
    const tone: []const u8 = if (v >= 0.005) "adm-gain" else if (v <= -0.005) "adm-loss" else return base;
    return arena.print("{s} {s}", .{ base, tone }) catch base;
}

const zx = @import("zx");
const finance = @import("../../finance.zig");
const shared = @import("shared.zig");
