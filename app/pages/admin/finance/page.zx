pub fn Page(ctx: zx.PageContext) !zx.Component {
    finance.history.record() catch |err| zx.log.warn("admin: finance history snapshot failed: {any}", .{err});
    const ibkr = credentials.IbkrForm.load(ctx.arena);
    const flash = ui.flashFrom(ctx.request.query, &.{
        .{ "synced_no_cash", messages.synced_no_cash },
        .{ "not_configured", messages.not_configured },
        .{ "ibkr", messages.ibkr },
        .{ "pending", messages.pending },
        .{ "empty", messages.empty },
        .{ "failed", messages.failed },
    });

    return (
        <div @allocator={ctx.arena}>
            <Toolbar @client page={.portfolio} needs_ibkr={!ibkr.token_set or ibkr.query_id.len == 0} flash={flash} />

            <div
                @async={.stream}
                @fallback={(<Kpis loading={true} />)}
            >
                <Kpis loading={false} @caching="15s:finance_kpis" />
            </div>

            <AllocationCard @client allocations={finance.allocations.actuals(ctx.arena) catch &.{}} />

            <div class="adm-split">
                <AccountsPanel />

                <div
                    @async={.stream}
                    @fallback={(<HoldingsPanel loading={true} />)}
                >
                    <HoldingsPanel loading={false} @caching="15s:finance_holdings" />
                </div>
            </div>
        </div>
    );
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .streamed,
};

const zx = @import("zx");
const ui = @import("../ui.zx");
const credentials = @import("../../../db/credentials.zig");
const finance = @import("../../finance.zig");
const toolbar = @import("toolbar.zx");
const messages = toolbar.messages;
const Kpis = @import("kpis.zx").Kpis;
const AccountsPanel = @import("accounts_panel.zx").AccountsPanel;
const HoldingsPanel = @import("holdings_panel.zx").HoldingsPanel;
pub const Toolbar = toolbar.Toolbar;
pub const AllocationCard = @import("allocation_card.zx").AllocationCard;
