pub fn Page(ctx: zx.PageContext) !zx.Component {
    finance.recordHistory() catch |err| zx.log.warn("admin: finance history snapshot failed: {any}", .{err});
    const ibkr_form = credentials.loadIbkrForm(ctx.arena);
    const needs_ibkr = !ibkr_form.token_set or ibkr_form.query_id.len == 0;
    const flash = ui.flashFrom(ctx.request.query, &.{
        .{ "synced", "IBKR balances and holdings refreshed." },
        .{ "synced_no_cash", "Synced holdings, but Flex had no Cash Report / Equity Summary - add both in Client Portal so cash is included." },
        .{ "not_configured", "Add IBKR Flex credentials under Settings first." },
        .{ "ibkr", "IBKR rejected the Flex request. Check token and query ID." },
        .{ "pending", "IBKR is still generating the report. Sync again in a few seconds." },
        .{ "empty", "Flex report had no accounts. Confirm the query covers your sub-accounts." },
        .{ "failed", "Something went wrong. Check the server logs." },
    });

    return (
        <div @allocator={ctx.arena}>
            <Toolbar @client page={.portfolio} needs_ibkr={needs_ibkr} flash={flash} />

            <div
                @async={.stream}
                @fallback={(<Kpis loading={true} />)}
            >
                <Kpis loading={false} @caching="15s:finance_kpis" />
            </div>

            <AllocationCard @client allocations={finance.listAllocationActuals(ctx.arena) catch &.{}} />

            <div class="adm-split">
                <AccountsPanel />

                <div
                    @async={.stream}
                    @fallback={(<HoldingsPanel loading={true} />)}
                >
                    <HoldingsPanel loading={false} @caching="15s:finance_holdings" />
                </div>
            </div>
        </div>
    );
}

pub const options: zx.PageOptions = .{
    .methods = &.{.GET, .POST},
    .rendering = .streamed,
};

const zx = @import("zx");

const ui = @import("../ui.zx");
const credentials = @import("../../../db/credentials.zig");
const finance = @import("../../finance/db.zig");

const dashboard = @import("dashboard.zx");
pub const Toolbar = dashboard.Toolbar;
const Kpis = dashboard.Kpis;
pub const AllocationCard = dashboard.AllocationCard;
const AccountsPanel = dashboard.AccountsPanel;
const HoldingsPanel = dashboard.HoldingsPanel;
