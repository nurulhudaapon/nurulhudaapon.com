pub fn Page(ctx: zx.PageContext) !zx.Component {
    const accounts = try finance.accounts.list(ctx.arena);
    const asset_classes = try finance.classes.list(ctx.arena);
    const groups = try finance.accounts.groups(ctx.arena);
    const usd_bdt_rate = finance.fx.usdBdt(ctx.arena);
    const now = std.Io.Timestamp.now(ctx.io, .real).toSeconds();
    const flash = ui.flashFrom(ctx.request.query, &.{
        .{ "synced_no_cash", toolbar.messages.synced_no_cash },
    });

    return (
        <div @allocator={ctx.arena}>
            <RowMenuCloser @client />
            <Toolbar @client page={.accounts} flash={flash} />

            <section class="adm-card adm-card-gap">
                <div class="adm-section-head">
                    <span>All accounts</span>
                    <div class="adm-page-actions">
                        <a class="adm-btn adm-btn-ghost" href="/admin/finance/accounts.csv" download="accounts.csv">Export CSV</a>
                        <a class="adm-btn adm-btn-primary" href="/admin/finance/accounts/new">Add account</a>
                    </div>
                </div>
                {if (accounts.len == 0) (
                    <div class="adm-card-pad"><ui.Empty text="No accounts yet. Add one or sync IBKR." /></div>
                ) else (
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th class="adm-hide-sm">Type</th>
                                    <th>Asset class</th>
                                    <th>Balance</th>
                                    <th>Weight</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {for (accounts) |a| (
                                    <AccountItem
                                        @client
                                        account={a}
                                        needs_update={a.needsUpdate(now)}
                                        asset_classes={asset_classes}
                                    />
                                )}
                            </tbody>
                        </table>
                    </div>
                )}
            </section>

            {if (groups.len > 0) (
                <section id="groups" class="adm-card adm-card-gap">
                    <div class="adm-section-head">
                        <span>Groups</span>
                        <span class="adm-hint">Renaming to an existing group merges them</span>
                    </div>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Accounts</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {for (groups) |g| (
                                    <GroupItem @client name={g.name} account_count={g.account_count} />
                                )}
                            </tbody>
                        </table>
                    </div>
                </section>
            )}

            <p class="adm-hint" style="margin-top:0.5rem">
                FX via Frankfurter · 1 USD = {finance.format.money(ctx.arena, usd_bdt_rate, "BDT")} · <a href="/admin/finance/rates">Manage rates</a>
            </p>
        </div>
    );
}

fn accountSub(arena: zx.Allocator, a: finance.accounts.Account) []const u8 {
    return arena.print("{s}{s}{s}{s}{s}", .{
        if (a.institution.len > 0) a.institution else "-",
        if (std.mem.eql(u8, a.broker, "ibkr")) " · IBKR" else "",
        if (a.group_name.len > 0) " · " else "",
        a.group_name,
        if (a.isStale()) " · stale" else "",
    }) catch a.institution;
}

const ItemProps = struct {
    account: finance.accounts.Account,
    needs_update: bool,
    asset_classes: []const finance.classes.Class,
};

// Row actions update this in place; totals and weights catch up on the next load.
const ItemState = struct {
    id: i64 = 0,
    asset_class: []const u8 = "",
    stale: bool = false,
    deleted: bool = false,
    err: []const u8 = "",
};

pub fn AccountItem(ctx: *zx.ComponentCtx(ItemProps)) zx.Component {
    const p = ctx.props;
    const a = p.account;
    const stale = a.isStale();
    const item = ctx.state(ItemState, .{ .id = a.id, .asset_class = a.asset_class, .stale = stale });
    const set_class = ctx.action(setClass, .{});
    const set_stale = ctx.action(toggleStale, .{});
    const delete = ctx.action(deleteAccount, .{});
    const alloc = ctx.allocator;
    const state = item.get();
    const busy = set_class.pending or set_stale.pending or delete.pending;

    if (state.deleted) return (<tr @allocator={alloc} hidden></tr>);

    return (
        <tr @allocator={alloc} class={if (state.stale) "adm-row-stale" else ""} aria-busy={if (busy) "true" else "false"}>
            <td>
                <a class="adm-table-title adm-link-plain" href={shared.accountHref(alloc, a.id)}>{a.name}</a>
                {if (state.err.len > 0) (
                    <span class="adm-table-sub adm-text-err" role="status">{state.err}</span>
                ) else (
                    <span class="adm-table-sub">
                        {accountSub(alloc, a)}
                        {if (p.needs_update) (
                            <span class="adm-pill adm-pill-warn" title="Manual balance not updated in 30+ days">Needs update</span>
                        )}
                    </span>
                )}
            </td>
            <td class="adm-hide-sm">{a.type_label}</td>
            <td>
                <form action={set_class} class="adm-inline-fields">
                    <select class="adm-select" name="asset_class" disabled={set_class.pending}>
                        {for (p.asset_classes) |c| (
                            <option value={c.name} selected={std.mem.eql(u8, c.name, state.asset_class)}>{c.name}</option>
                        )}
                    </select>
                    <button class="adm-btn adm-btn-ghost" type="submit" disabled={set_class.pending}>
                        {if (set_class.pending) "Saving…" else "Set"}
                    </button>
                </form>
            </td>
            <td>
                <span class="adm-table-title">{finance.format.money(alloc, a.net_liquidation, a.currency)}</span>
                {if (!std.ascii.eqlIgnoreCase(a.currency, "USD")) (
                    <span class="adm-table-sub">{finance.format.money(alloc, a.value_usd, "USD")}</span>
                )}
            </td>
            <td>{if (state.stale or stale) "-" else if (a.isLiability()) "Debt" else finance.format.pct(alloc, a.weight_pct)}</td>
            <td class="adm-table-actions">
                <details class="adm-row-menu">
                    <summary class="adm-btn adm-btn-ghost adm-btn-icon" aria-label="Account actions">
                        {ui.icon(alloc, .more)}
                    </summary>
                    <div class="adm-row-menu-panel">
                        <a class="adm-row-menu-item" href={shared.editHref(alloc, a.id)}>Edit</a>
                        <form action={set_stale}>
                            <button class="adm-row-menu-item" type="submit" disabled={set_stale.pending}>
                                {if (set_stale.pending) "Saving…" else if (state.stale) "Restore to totals" else "Mark stale"}
                            </button>
                        </form>
                        {if (std.mem.eql(u8, a.broker, "manual")) (
                            <form action={delete}>
                                <button class="adm-row-menu-item adm-row-menu-danger" type="submit" disabled={delete.pending}>
                                    {if (delete.pending) "Deleting…" else "Delete"}
                                </button>
                            </form>
                        ) else (
                            <span class="adm-row-menu-meta">IBKR synced</span>
                        )}
                    </div>
                </details>
            </td>
        </tr>
    );
}

fn setClass(a: *zx.server.Action.Stateful) void {
    const item = a.state(ItemState);
    const class = a.data(struct { asset_class: []const u8 }).asset_class;
    var next = item.get();
    if (commit(&next, finance.accounts.setAssetClass(a.inner.arena, next.id, class))) next.asset_class = class;
    item.set(next);
}

fn toggleStale(a: *zx.server.Action.Stateful) void {
    const item = a.state(ItemState);
    var next = item.get();
    if (commit(&next, finance.accounts.setStale(next.id, !next.stale))) next.stale = !next.stale;
    item.set(next);
}

fn deleteAccount(a: *zx.server.Action.Stateful) void {
    const item = a.state(ItemState);
    var next = item.get();
    if (commit(&next, finance.accounts.deleteManual(next.id))) next.deleted = true;
    item.set(next);
}

const GroupState = struct {
    name: []const u8 = "",
    removed: bool = false,
    err: []const u8 = "",
};

pub fn GroupItem(ctx: *zx.ComponentCtx(finance.accounts.GroupSummary)) zx.Component {
    const group = ctx.state(GroupState, .{ .name = ctx.props.name });
    const rename = ctx.action(renameGroup, .{});
    const remove = ctx.action(ungroup, .{});
    const alloc = ctx.allocator;
    const state = group.get();

    if (state.removed) return (<tr @allocator={alloc} hidden></tr>);

    return (
        <tr @allocator={alloc}>
            <td>
                <form action={rename} class="adm-inline-fields">
                    <input class="adm-input" name="name" value={state.name} required aria-label="Group name" disabled={rename.pending} />
                    <button class="adm-btn adm-btn-ghost" type="submit" disabled={rename.pending}>
                        {if (rename.pending) "Saving…" else "Rename"}
                    </button>
                </form>
                {if (state.err.len > 0) (
                    <span class="adm-table-sub adm-text-err" role="status">{state.err}</span>
                )}
            </td>
            <td>{shared.accountCount(alloc, ctx.props.account_count)}</td>
            <td class="adm-table-actions">
                <form action={remove}>
                    <button class="adm-btn adm-btn-ghost" type="submit" disabled={remove.pending}>
                        {if (remove.pending) "Ungrouping…" else "Ungroup"}
                    </button>
                </form>
            </td>
        </tr>
    );
}

fn renameGroup(a: *zx.server.Action.Stateful) void {
    const group = a.state(GroupState);
    var next = group.get();
    const name = std.mem.trim(u8, a.data(struct { name: []const u8 }).name, " \t\r\n");
    if (name.len == 0) {
        next.err = "Give the group a name, or use Ungroup.";
    } else if (commit(&next, finance.accounts.renameGroup(next.name, name))) {
        next.name = name;
    }
    group.set(next);
}

fn ungroup(a: *zx.server.Action.Stateful) void {
    const group = a.state(GroupState);
    var next = group.get();
    if (commit(&next, finance.accounts.renameGroup(next.name, ""))) next.removed = true;
    group.set(next);
}

fn commit(next: anytype, result: anyerror!void) bool {
    result catch |err| {
        next.err = if (err == error.InvalidName) "Pick a valid asset class." else blk: {
            zx.log.err("admin: finance account action failed: {any}", .{err});
            break :blk "Something went wrong. Check the server logs.";
        };
        return false;
    };
    shared.changed();
    next.err = "";
    return true;
}

// Closes open row menus on any click outside them. Zig can't hand the DOM a
// listener, so this installs a small one once per page load.
pub fn RowMenuCloser(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    if (comptime zx.platform.role == .client) row_menu.install();
    return (<span @allocator={ctx.allocator} hidden aria-hidden="true"></span>);
}

const row_menu = struct {
    var installed = false;

    const listener =
        \\document.addEventListener("click", (e) => {
        \\  document.querySelectorAll("details.adm-row-menu[open]").forEach((d) => {
        \\    if (!d.contains(e.target)) d.removeAttribute("open");
        \\  });
        \\})
    ;

    fn install() void {
        if (installed) return;
        installed = true;
        _ = zx.client.eval(void, listener) catch {};
    }
};

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../../ui.zx");
const finance = @import("../../../finance.zig");
const shared = @import("../shared.zig");
const toolbar = @import("../toolbar.zx");
pub const Toolbar = toolbar.Toolbar;
