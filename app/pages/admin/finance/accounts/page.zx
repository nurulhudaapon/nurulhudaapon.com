pub fn Page(ctx: zx.PageContext) !zx.Component {
    const accounts = try finance.listAccounts(ctx.arena);
    const asset_classes = try finance.listAssetClasses(ctx.arena);
    const groups = try finance.listAccountGroups(ctx.arena);
    const usd_bdt_rate = finance.usdBdtRate(ctx.arena);
    const now = std.Io.Timestamp.now(zx.io(), .real).toSeconds();
    const flash = ui.flashFrom(ctx.request.queries, &.{
        .{ "synced", "IBKR balances and holdings refreshed." },
        .{ "synced_no_cash", "Synced holdings, but Flex had no Cash Report / Equity Summary - add both in Client Portal so cash is included." },
    });

    return (
        <div @allocator={ctx.arena}>
            <RowMenuOutsideClose @client />
            <Toolbar @client page={.accounts} flash={flash} />

            <section class="adm-card adm-card-gap">
                <div class="adm-section-head">
                    <span>All accounts</span>
                    <a class="adm-btn adm-btn-primary" href="/admin/finance/accounts/new">Add account</a>
                </div>
                {if (accounts.len == 0) (
                    <div class="adm-card-pad"><ui.Empty text="No accounts yet. Add one or sync IBKR." /></div>
                ) else (
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th class="adm-hide-sm">Type</th>
                                    <th>Asset class</th>
                                    <th>Balance</th>
                                    <th>Weight</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {for (accounts) |a| (
                                    <AccountItem
                                        @client
                                        account={a}
                                        needs_update={finance.needsBalanceUpdate(a, now)}
                                        asset_classes={asset_classes}
                                    />
                                )}
                            </tbody>
                        </table>
                    </div>
                )}
            </section>

            {if (groups.len > 0) (
                <section id="groups" class="adm-card adm-card-gap">
                    <div class="adm-section-head">
                        <span>Groups</span>
                        <span class="adm-hint">Renaming to an existing group merges them</span>
                    </div>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Accounts</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {for (groups) |g| (
                                    <GroupItem @client name={g.name} account_count={g.account_count} />
                                )}
                            </tbody>
                        </table>
                    </div>
                </section>
            )}

            <p class="adm-hint" style="margin-top:0.5rem">
                FX via Frankfurter · 1 USD = {finance.formatMoney(ctx.arena, usd_bdt_rate, "BDT")} · <a href="/admin/finance/rates">Manage rates</a>
            </p>
        </div>
    );
}

fn accountSub(arena: zx.Allocator, a: finance.Account) []const u8 {
    return arena.print("{s}{s}{s}{s}{s}", .{
        if (a.institution.len > 0) a.institution else "-",
        if (std.mem.eql(u8, a.broker, "ibkr")) " · IBKR" else "",
        if (a.group_name.len > 0) " · " else "",
        a.group_name,
        if (finance.isAccountStale(a)) " · stale" else "",
    }) catch a.institution;
}

const ItemProps = struct {
    account: finance.Account,
    needs_update: bool,
    asset_classes: []const finance.AssetClass,
};

// Row actions update this in place; totals and weights catch up on the next load.
const ItemState = struct {
    id: i64 = 0,
    asset_class: []const u8 = "",
    stale: bool = false,
    deleted: bool = false,
    err: []const u8 = "",
};

pub fn AccountItem(ctx: *zx.ComponentCtx(ItemProps)) zx.Component {
    const p = ctx.props;
    const a = p.account;
    const stale = finance.isAccountStale(a);
    const item = ctx.state(ItemState, .{ .id = a.id, .asset_class = a.asset_class, .stale = stale });
    const class_action = ctx.action(setClass, .{});
    const stale_action = ctx.action(toggleStale, .{});
    const delete_action = ctx.action(deleteAccount, .{});
    const alloc = ctx.allocator;
    const state = item.get();
    const busy = class_action.pending or stale_action.pending or delete_action.pending;

    if (state.deleted) return (<tr @allocator={alloc} hidden></tr>);

    return (
        <tr @allocator={alloc} class={if (state.stale) "adm-row-stale" else ""} aria-busy={if (busy) "true" else "false"}>
            <td>
                <a class="adm-table-title adm-link-plain" href={dashboard.accountHref(alloc, a.id)}>{a.name}</a>
                {if (state.err.len > 0) (
                    <span class="adm-table-sub adm-text-err" role="status">{state.err}</span>
                ) else (
                    <span class="adm-table-sub">
                        {accountSub(alloc, a)}
                        {if (p.needs_update) (
                            <span class="adm-pill adm-pill-warn" title="Manual balance not updated in 30+ days">Needs update</span>
                        )}
                    </span>
                )}
            </td>
            <td class="adm-hide-sm">{a.type_label}</td>
            <td>
                <form action={class_action} class="adm-inline-fields">
                    <select class="adm-select" name="asset_class" disabled={class_action.pending}>
                        {for (p.asset_classes) |c| (
                            <option value={c.name} selected={std.mem.eql(u8, c.name, state.asset_class)}>{c.name}</option>
                        )}
                    </select>
                    <button class="adm-btn adm-btn-ghost" type="submit" disabled={class_action.pending}>
                        {if (class_action.pending) "Saving…" else "Set"}
                    </button>
                </form>
            </td>
            <td>
                <span class="adm-table-title">{finance.formatMoney(alloc, a.net_liquidation, a.currency)}</span>
                {if (!std.ascii.eqlIgnoreCase(a.currency, "USD")) (
                    <span class="adm-table-sub">{finance.formatMoney(alloc, a.value_usd, "USD")}</span>
                )}
            </td>
            <td>{if (state.stale or stale) "-" else if (finance.isLiability(a)) "Debt" else finance.formatPct(alloc, a.weight_pct)}</td>
            <td class="adm-table-actions">
                <details class="adm-row-menu">
                    <summary class="adm-btn adm-btn-ghost adm-btn-icon" aria-label="Account actions">
                        {ui.icon(alloc, .more)}
                    </summary>
                    <div class="adm-row-menu-panel">
                        <a class="adm-row-menu-item" href={alloc.print("/admin/finance/accounts/{d}/edit", .{a.id}) catch ""}>Edit</a>
                        <form action={stale_action}>
                            <button class="adm-row-menu-item" type="submit" disabled={stale_action.pending}>
                                {if (stale_action.pending) "Saving…" else if (state.stale) "Restore to totals" else "Mark stale"}
                            </button>
                        </form>
                        {if (std.mem.eql(u8, a.broker, "manual")) (
                            <form action={delete_action}>
                                <button class="adm-row-menu-item adm-row-menu-danger" type="submit" disabled={delete_action.pending}>
                                    {if (delete_action.pending) "Deleting…" else "Delete"}
                                </button>
                            </form>
                        ) else (
                            <span class="adm-row-menu-meta">IBKR synced</span>
                        )}
                    </div>
                </details>
            </td>
        </tr>
    );
}

const ClassInput = struct { asset_class: []const u8 };

fn setClass(a: *zx.server.Action.Stateful) void {
    const item = a.state(ItemState);
    const input = a.data(ClassInput);
    var next = item.get();
    finance.setAccountAssetClass(a.inner.arena, next.id, input.asset_class) catch |err| {
        next.err = rowError(err);
        return item.set(next);
    };
    dashboard.financeChanged();
    next.asset_class = input.asset_class;
    next.err = "";
    item.set(next);
}

fn toggleStale(a: *zx.server.Action.Stateful) void {
    const item = a.state(ItemState);
    var next = item.get();
    finance.setAccountStale(next.id, !next.stale) catch |err| {
        next.err = rowError(err);
        return item.set(next);
    };
    dashboard.financeChanged();
    next.stale = !next.stale;
    next.err = "";
    item.set(next);
}

fn deleteAccount(a: *zx.server.Action.Stateful) void {
    const item = a.state(ItemState);
    var next = item.get();
    finance.deleteManualAccount(next.id) catch |err| {
        next.err = rowError(err);
        return item.set(next);
    };
    dashboard.financeChanged();
    next.deleted = true;
    item.set(next);
}

const GroupItemState = struct {
    name: []const u8 = "",
    removed: bool = false,
    err: []const u8 = "",
};

pub fn GroupItem(ctx: *zx.ComponentCtx(finance.GroupSummary)) zx.Component {
    const group = ctx.state(GroupItemState, .{ .name = ctx.props.name });
    const rename_action = ctx.action(renameGroup, .{});
    const ungroup_action = ctx.action(ungroup, .{});
    const alloc = ctx.allocator;
    const state = group.get();
    const count = ctx.props.account_count;

    if (state.removed) return (<tr @allocator={alloc} hidden></tr>);

    return (
        <tr @allocator={alloc}>
            <td>
                <form action={rename_action} class="adm-inline-fields">
                    <input class="adm-input" name="name" value={state.name} required aria-label="Group name" disabled={rename_action.pending} />
                    <button class="adm-btn adm-btn-ghost" type="submit" disabled={rename_action.pending}>
                        {if (rename_action.pending) "Saving…" else "Rename"}
                    </button>
                </form>
                {if (state.err.len > 0) (
                    <span class="adm-table-sub adm-text-err" role="status">{state.err}</span>
                )}
            </td>
            <td>{alloc.print("{d} account{s}", .{ count, if (count == 1) "" else "s" }) catch ""}</td>
            <td class="adm-table-actions">
                <form action={ungroup_action}>
                    <button class="adm-btn adm-btn-ghost" type="submit" disabled={ungroup_action.pending}>
                        {if (ungroup_action.pending) "Ungrouping…" else "Ungroup"}
                    </button>
                </form>
            </td>
        </tr>
    );
}

const RenameInput = struct { name: []const u8 };

fn renameGroup(a: *zx.server.Action.Stateful) void {
    const group = a.state(GroupItemState);
    var next = group.get();
    const name = std.mem.trim(u8, a.data(RenameInput).name, " \t\r\n");
    if (name.len == 0) {
        next.err = "Give the group a name, or use Ungroup.";
        return group.set(next);
    }
    finance.renameGroup(next.name, name) catch |err| {
        next.err = rowError(err);
        return group.set(next);
    };
    dashboard.financeChanged();
    next.name = name;
    next.err = "";
    group.set(next);
}

fn ungroup(a: *zx.server.Action.Stateful) void {
    const group = a.state(GroupItemState);
    var next = group.get();
    finance.renameGroup(next.name, "") catch |err| {
        next.err = rowError(err);
        return group.set(next);
    };
    dashboard.financeChanged();
    next.removed = true;
    group.set(next);
}

fn rowError(err: anyerror) []const u8 {
    if (err == error.InvalidName) return "Pick a valid asset class.";
    zx.log.err("admin: finance account action failed: {any}", .{err});
    return "Something went wrong. Check the server logs.";
}

pub fn RowMenuOutsideClose(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    if (comptime zx.platform.role == .client) ensureRowMenuOutsideClose();
    return (<span @allocator={ctx.allocator} hidden aria-hidden="true"></span>);
}

var row_menu_listener = false;

fn ensureRowMenuOutsideClose() void {
    if (row_menu_listener) return;
    row_menu_listener = true;
    _ = zx.client.eval(void,
        \\(() => {
        \\  if (window.__admRowMenuOutside) return;
        \\  window.__admRowMenuOutside = true;
        \\  document.addEventListener("click", (e) => {
        \\    document.querySelectorAll("details.adm-row-menu[open]").forEach((d) => {
        \\      if (!d.contains(e.target)) d.removeAttribute("open");
        \\    });
        \\  });
        \\})()
    ) catch {};
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const ui = @import("../../ui.zx");
const finance = @import("../../../finance/db.zig");
const dashboard = @import("../dashboard.zx");
pub const Toolbar = dashboard.Toolbar;
