pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    const current_year = blk: {
        const timestamp: i64 = @intCast(@divFloor(std.Io.Timestamp.now(zx.io(), .real).nanoseconds, std.time.ns_per_s));
        const seconds_per_year = 365.25 * 24 * 60 * 60;
        const years_since_epoch = @as(i64, @intFromFloat(@as(f64, @floatFromInt(timestamp)) / seconds_per_year));
        break :blk 1970 + years_since_epoch;
    };
    const copyright = ctx.fmt("© {d} {s}.", .{ current_year, data.author }) catch data.author;

    const path = ctx.request.pathname;
    if (isAdminPath(path)) return AdminDocument(ctx, children);
    if (isDevPath(path)) return DevDocument(ctx, children);
    // Pages set these through `ctx.data`; anything unset falls back to the site defaults.
    const title = ctx.data.get("title") orelse data.title;
    const description = ctx.data.get("description") orelse data.description;
    const robots = ctx.data.get("robots") orelse "index, follow";

    const origin = siteOrigin(ctx);
    const page_url = blk: {
        if (std.mem.eql(u8, path, "/") or std.mem.eql(u8, path, "")) break :blk origin;
        const clean = if (std.mem.endsWith(u8, path, "/")) path[0 .. path.len - 1] else path;
        break :blk ctx.fmt("{s}{s}", .{ origin, clean }) catch data.url;
    };
    const og_image_url = blk: {
        if (ctx.data.get("og_image")) |og_path| break :blk ctx.fmt("{s}{s}", .{ origin, og_path }) catch data.og_image;
        if (std.mem.eql(u8, path, "/") or std.mem.eql(u8, path, ""))
            break :blk ctx.fmt("{s}/og/home.png", .{origin}) catch data.og_image;
        const clean = if (std.mem.endsWith(u8, path, "/")) path[0 .. path.len - 1] else path;
        break :blk ctx.fmt("{s}/og{s}.png", .{ origin, clean }) catch data.og_image;
    };

    return (
        <html @allocator={ctx.arena} lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>{title}</title>
                <meta name="description" content={description} />
                <meta name="author" content={data.author} />
                <meta name="robots" content={robots} />
                <meta property="og:title" content={title} />
                <meta property="og:description" content={description} />
                <meta property="og:type" content="website" />
                <meta property="og:url" content={page_url} />
                <meta property="og:site_name" content="nurulhudaapon.com" />
                <meta property="og:image" content={og_image_url} />
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
                <meta property="og:image:alt" content={title} />
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:title" content={title} />
                <meta name="twitter:description" content={description} />
                <meta name="twitter:image" content={og_image_url} />
                <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />
                <link rel="stylesheet" href="/assets/style.css" />
            </head>
            <body>
                {children}
                <footer class="site-footer">
                    <div class="copyright">{copyright}</div>
                    <div class="social-links">
                        {for (data.social) |link| (
                            if (std.mem.startsWith(u8, link.href, "mailto:")) (
                                <a href={link.href} aria-label={link.label}>
                                    {icon(ctx.arena, link.icon)}
                                </a>
                            ) else (
                                <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
                                    {icon(ctx.arena, link.icon)}
                                </a>
                            )
                        )}
                    </div>
                </footer>
            </body>
        </html>
    );
}

fn AdminDocument(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <meta name="robots" content="noindex, nofollow" />
                <title>Admin · {data.author}</title>
                <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />
                <link rel="stylesheet" href="/assets/style.css" />
                <link rel="stylesheet" href="/assets/admin.css" />
            </head>
            <body class="admin-body">
                {children}
            </body>
        </html>
    );
}

fn isAdminPath(path: []const u8) bool {
    return std.mem.eql(u8, path, "/admin") or std.mem.startsWith(u8, path, "/admin/") or
        std.mem.startsWith(u8, path, "/auth/");
}

fn isDevPath(path: []const u8) bool {
    return std.mem.eql(u8, path, "/dev") or std.mem.startsWith(u8, path, "/dev/");
}

fn siteOrigin(ctx: zx.LayoutContext) []const u8 {
    if (@import("builtin").optimize == .debug) {
        if (ctx.request.headers.get("host")) |host| {
            if (host.len > 0) {
                return ctx.fmt("http://{s}", .{host}) catch data.url;
            }
        }
        if (originFromUrl(ctx.request.url)) |origin| return origin;
    }
    return data.url;
}

fn originFromUrl(url: []const u8) ?[]const u8 {
    const scheme_end = std.mem.indexOf(u8, url, "://") orelse return null;
    const after_scheme = url[scheme_end + 3 ..];
    const path_start = std.mem.indexOfScalar(u8, after_scheme, '/') orelse after_scheme.len;
    return url[0 .. scheme_end + 3 + path_start];
}

fn icon(allocator: zx.Allocator, icon_type: IconType) zx.Component {
    return switch (icon_type) {
        .email => icons.Email(allocator),
        .github => icons.GitHub(allocator),
        .npm => icons.Npm(allocator),
        .x => icons.X(allocator),
        .linkedin => icons.LinkedIn(allocator),
        .youtube => icons.YouTube(allocator),
    };
}

const IconType = enum {
    email,
    github,
    npm,
    x,
    linkedin,
    youtube,
};

const Link = struct {
    label: []const u8,
    href: []const u8,
    icon: IconType,
};

const SiteData = struct {
    title: []const u8,
    description: []const u8,
    author: []const u8,
    url: []const u8,
    og_image: []const u8,
    social: []const Link,
};

const data: SiteData = @import("data.zon");

pub const options: zx.LayoutOptions = .{ .rendering = .prerendered };

const DevDocument = @import("dev/document.zx").Document;
const icons = @import("component.zx").icons;
const std = @import("std");
const zx = @import("zx");
