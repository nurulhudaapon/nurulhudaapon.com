// The passkey page script from `zx.Auth.WebAuthn.script`; render it after the
// `[data-passkey]` buttons so unsupported browsers can hide them.
pub fn Script(allocator: zx.Allocator) zx.Component {
    return (
        <script @allocator={allocator} @escaping={.none}>{script}</script>
    );
}

const script = zx.Auth.WebAuthn.script;

const zx = @import("zx");
