const Props = struct { days: []const slots.Day, slot_minutes: i64 };

const Result = struct {
    booked_at: i64 = 0,
    err: []const u8 = "",
};

const BookInput = struct {
    name: []const u8,
    email: []const u8,
    notes: []const u8,
    website: []const u8,
};

pub fn Scheduler(ctx: *zx.ComponentCtx(Props)) zx.Component {
    const day_idx = ctx.state(usize, firstOpenDay(ctx.props.days));
    const slot = ctx.state(i64, 0);
    const result = ctx.state(Result, .{});
    const book_action = ctx.action(book, .{});
    const pending = book_action.pending;
    const alloc = ctx.allocator;
    const days = ctx.props.days;

    if (result.get().booked_at != 0) {
        return (
            <div @allocator={alloc} class="schedule-done">
                <p class="ask-flash ask-flash-success">
                    You're booked for {viewer.when(alloc, result.get().booked_at)}. A calendar invite with the meeting link is on its way to your email.
                </p>
                <a class="schedule-back" href="/schedule">Book another time</a>
            </div>
        );
    }

    if (days.len == 0) {
        return (<p @allocator={alloc} class="schedule-empty">No open times right now. Email me at me@nurulhudaapon.com instead.</p>);
    }

    const day = days[@min(day_idx.get(), days.len - 1)];
    const err = result.get().err;
    // Hidden rather than omitted: ziex registers server actions during the server render.
    const form_class = if (slot.get() == 0) "schedule-form schedule-form-hidden" else "schedule-form";
    const zone = viewer.zone(alloc);

    return (
        <div @allocator={alloc} class="schedule-picker">
            {if (err.len > 0) (
                <p class="schedule-flash">{err}</p>
            )}
            <div class="schedule-meta">
                <p class="schedule-zone" title={zone}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M2 12h20" />
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                    <span class={viewer.class("")}>
                        Times in <strong>{cityName(alloc, zone)}</strong> ({viewer.offsetLabel(alloc, firstSlot(days))})
                    </span>
                </p>
                <p class="schedule-tz">{ctx.props.slot_minutes}-minute meetings</p>
            </div>
            <nav class="schedule-days" aria-label="Choose a day">
                {for (days, 0..) |d, i| (
                    <button
                        type="button"
                        class={dayClass(d, i == day_idx.get())}
                        value={i}
                        aria-pressed={if (i == day_idx.get()) "true" else "false"}
                        disabled={pending}
                        onclick={ctx.bind(pickDay)}
                    >
                        <span class="schedule-day-weekday">{d.weekday}</span>
                        <span class="schedule-day-date">{d.day_of_month}</span>
                        <span class="schedule-day-month">{d.month}</span>
                        <span class="schedule-day-count">{dayCount(alloc, d)}</span>
                    </button>
                )}
            </nav>
            <section class="schedule-slots" aria-label="Available times">
                {if (day.slots.len == 0) (
                    <p class="schedule-empty">This day is fully booked. Please pick another.</p>
                )}
                {for (day.slots) |s| (
                    <button
                        type="button"
                        class={if (s.start == slot.get()) "schedule-slot schedule-slot-selected" else "schedule-slot"}
                        value={s.start}
                        disabled={pending}
                        onclick={ctx.bind(pickSlot)}
                    >
                        <span class={viewer.class("")}>{viewer.time(alloc, s.start)}</span>
                    </button>
                )}
            </section>
            <form class={form_class} action={book_action}>
                <p class="schedule-form-when">{if (slot.get() == 0) "" else viewer.when(alloc, slot.get())}</p>
                <label class="schedule-label">
                    Name
                    <input class="schedule-input" type="text" name="name" required maxlength="100" autocomplete="name" disabled={pending} />
                </label>
                <label class="schedule-label">
                    Email
                    <input class="schedule-input" type="email" name="email" required maxlength="200" autocomplete="email" disabled={pending} />
                </label>
                <label class="schedule-label">
                    What would you like to talk about?
                    <textarea class="schedule-input" name="notes" rows="3" maxlength="2000" disabled={pending}></textarea>
                </label>
                <input class="form-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="schedule-form-actions">
                    <button class="ask-submit" type="submit" disabled={pending}>{if (pending) "Booking…" else "Book meeting"}</button>
                </div>
            </form>
        </div>
    );
}

pub fn MeetingTime(ctx: *zx.ComponentCtx(struct { start: i64, end: i64 })) zx.Component {
    const alloc = ctx.allocator;
    const start = ctx.props.start;
    return (
        <p @allocator={alloc} class="meeting-when">
            <span class={viewer.class("meeting-when-main")}>{viewer.when(alloc, start)}</span>
            <span class={viewer.class("meeting-when-sub")}>Until {viewer.time(alloc, ctx.props.end)}, {viewer.zoneLabel(alloc, start)}</span>
        </p>
    );
}

fn pickDay(e: *zx.client.Event.Stateful) void {
    const idx = std.fmt.parseInt(usize, e.value() orelse return, 10) catch return;
    e.state(usize).set(idx);
    e.state(i64).set(0);
    e.state(Result).set(.{});
}

// State handles are positional, so the day slot is taken and skipped.
fn pickSlot(e: *zx.client.Event.Stateful) void {
    const start = std.fmt.parseInt(i64, e.value() orelse return, 10) catch return;
    _ = e.state(usize);
    e.state(i64).set(start);
    e.state(Result).set(.{});
}

fn book(a: *zx.server.Action.Stateful) void {
    _ = a.state(usize);
    const slot = a.state(i64);
    const result = a.state(Result);
    const input = a.data(BookInput);
    const arena = a.inner.arena;

    const outcome = booking.book(arena, a.inner.io, slot.get(), .{
        .name = input.name,
        .email = input.email,
        .notes = input.notes,
        .honeypot = input.website,
        .origin = site.origin(a.inner.request),
        .ip = a.inner.request.headers.get("cf-connecting-ip"),
    });
    switch (outcome) {
        .booked => {
            // /schedule already sees the booking; the sync brings it into the admin calendar.
            _ = calendars.requestSync(arena, a.inner.io, a.inner.response, true);
            result.set(.{ .booked_at = slot.get() });
        },
        .invalid => result.set(.{ .err = "Please check your details and pick a valid time." }),
        .taken => {
            slot.set(0);
            result.set(.{ .err = "Sorry, that time was just taken. Please pick another." });
        },
        .limited => result.set(.{ .err = "You already have meetings booked. Email me at me@nurulhudaapon.com if you need another." }),
        .failed => result.set(.{ .err = "Something went wrong while booking. Please try again or email me." }),
    }
}

fn firstOpenDay(days: []const slots.Day) usize {
    for (days, 0..) |d, i| if (d.slots.len > 0) return i;
    return 0;
}

fn firstSlot(days: []const slots.Day) i64 {
    const d = days[firstOpenDay(days)];
    return if (d.slots.len > 0) d.slots[0].start else 0;
}

fn dayClass(d: slots.Day, selected: bool) []const u8 {
    if (selected) return "schedule-day schedule-day-selected";
    if (d.slots.len == 0) return "schedule-day schedule-day-full";
    return "schedule-day";
}

fn dayCount(alloc: zx.Allocator, d: slots.Day) []const u8 {
    if (d.slots.len == 0) return "Full";
    return alloc.print("{d} open", .{d.slots.len}) catch "";
}

fn cityName(alloc: zx.Allocator, zone: []const u8) []const u8 {
    const start = if (std.mem.lastIndexOfScalar(u8, zone, '/')) |i| i + 1 else 0;
    if (start == zone.len) return zone;
    const city = alloc.dupe(u8, zone[start..]) catch return zone;
    std.mem.replaceScalar(u8, city, '_', ' ');
    return city;
}

// Times in the viewer's zone. The server renders them in Asia/Dhaka, so they
// keep their space hidden until the browser re-renders them.
const viewer = struct {
    const js = zx.client.js;
    const is_client = zx.platform.role == .client;
    const fallback_offset = slots.config.utc_offset_s;

    fn class(comptime base: []const u8) []const u8 {
        const sep = if (base.len > 0) " " else "";
        return if (is_client) base else base ++ sep ++ "tz-pending";
    }

    fn offset(unix: i64) i64 {
        if (!is_client) return fallback_offset;
        const Date = js.global.get(js.Object, "Date") catch return fallback_offset;
        defer Date.deinit();
        const date = Date.new(.{unix * std.time.ms_per_s}) catch return fallback_offset;
        defer date.deinit();
        const minutes = date.call(f64, "getTimezoneOffset", .{}) catch return fallback_offset;
        return -@as(i64, @intFromFloat(minutes)) * std.time.s_per_min;
    }

    fn zone(alloc: zx.Allocator) []const u8 {
        if (!is_client) return slots.config.timezone;
        const unknown = "your local time";
        const intl = js.global.get(js.Object, "Intl") catch return unknown;
        defer intl.deinit();
        const format = intl.call(js.Object, "DateTimeFormat", .{}) catch return unknown;
        defer format.deinit();
        const resolved = format.call(js.Object, "resolvedOptions", .{}) catch return unknown;
        defer resolved.deinit();
        return resolved.getAlloc(js.String, alloc, "timeZone") catch unknown;
    }

    fn zoneLabel(alloc: zx.Allocator, unix: i64) []const u8 {
        return alloc.print("{s} ({s})", .{ zone(alloc), offsetLabel(alloc, unix) }) catch "";
    }

    fn offsetLabel(alloc: zx.Allocator, unix: i64) []const u8 {
        return slots.formatOffset(alloc, offset(unix)) catch "";
    }

    fn time(alloc: zx.Allocator, unix: i64) []const u8 {
        return slots.formatTime12(alloc, unix, offset(unix)) catch "";
    }

    fn when(alloc: zx.Allocator, unix: i64) []const u8 {
        const date = slots.formatDate(alloc, unix, offset(unix)) catch "";
        return alloc.print("{s} at {s} ({s})", .{ date, time(alloc, unix), offsetLabel(alloc, unix) }) catch "";
    }
};

const zx = @import("zx");
const std = @import("std");
const slots = @import("slots.zig");
const booking = @import("booking.zig");
const site = @import("../../site.zig");
const calendars = @import("calendars.zig");
