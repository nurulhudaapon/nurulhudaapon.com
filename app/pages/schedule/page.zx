pub fn Page(ctx: zx.PageContext) zx.Component {
    ctx.data.set("title", "Schedule - Nurul Huda (Apon)");
    ctx.data.set("description", "Pick a time that works for you and let's talk.");
    const rules = settings.load(ctx.arena);
    const now = std.Io.Timestamp.now(ctx.io, .real).toSeconds();
    const days = openDays(ctx, rules, now);

    return (
        <main @allocator={ctx.arena} class="page-inner page-schedule">
            <div class="page-inner-content">
                <div class="page-nav">
                    <Navbar />
                </div>
                <div class="schedule-content">
                    <p class="schedule-intro">Pick a time that works for you and let's talk.</p>
                    {if (days) |d| (
                        <Scheduler @client days={d} slot_minutes={rules.slot_minutes} />
                    ) else (
                        <p class="schedule-empty">
                            Scheduling is temporarily unavailable. Please email me at <a href="mailto:me@nurulhudaapon.com">me@nurulhudaapon.com</a>.
                        </p>
                    )}
                </div>
            </div>
        </main>
    );
}

// Reads the synced copies only: a stale copy queues a sync for later visitors
// rather than making this one wait for it.
fn openDays(ctx: zx.PageContext, rules: slots.Rules, now: i64) ?[]const slots.Day {
    const arena = ctx.arena;
    const creds = (caldav.credentials(arena) catch null) orelse return null;
    const busy = calendars.busy(arena, ctx.io, creds, slots.horizon(rules, now), false) catch |err| {
        zx.log.err("schedule: failed to load busy times: {any}", .{err});
        return null;
    };
    if (busy.stale) _ = calendars.requestSync(arena, ctx.io, ctx.response, false);
    return slots.availableDays(arena, rules, now, busy.intervals) catch null;
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .rendering = .request,
};

const std = @import("std");
const zx = @import("zx");
const Navbar = @import("../component.zx").Navbar;
pub const Scheduler = @import("scheduler.zx").Scheduler;
const slots = @import("slots.zig");
const caldav = @import("caldav.zig");
const settings = @import("settings.zig");
const calendars = @import("calendars.zig");
