pub fn Document(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en-US">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <meta name="color-scheme" content="dark light" />
                <title>{title}</title>
                <meta name="description" content={description} />
                <meta name="author" content="Nurul Huda (Apon)" />
                <meta name="robots" content="index, follow" />
                <link rel="canonical" href={domain ++ "/"} />
                <meta property="og:type" content="website" />
                <meta property="og:url" content={domain ++ "/"} />
                <meta property="og:title" content={title} />
                <meta property="og:description" content={description} />
                <meta property="og:site_name" content="nuhu.dev" />
                <meta property="og:image" content={og_image_url} />
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
                <meta property="og:image:alt" content={title} />
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:image" content={og_image_url} />
                <meta name="twitter:title" content={title} />
                <meta name="twitter:description" content={description} />
                <link rel="icon" href="/nuhu-dev-favicon.ico" sizes="32x32" type="image/x-icon" />
                <link rel="stylesheet" href="/assets/dev.css" />
                <components.GtmHead />
            </head>

            <body class="dev-body">
                <components.GtmBody />

                {children}
            </body>
        </html>
    );
}

const domain = "https://nuhu.dev";
const og_image_url = domain ++ "/nuhu-dev-og.png";
const title = "nuhu.dev - Nurul Huda (Apon)";
const description = "Engineer crafting developer tooling, web infrastructure, and open source. Ziex, zzon and more, built in the open.";

const components = @import("components.zx");

const zx = @import("zx");
