pub fn GtmHead(allocator: zx.Allocator) ?zx.Component {
    if (builtin.optimize == .debug) return null;

    return (
        <script @allocator={allocator} @escaping={.none}>
            {
                \\(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                \\new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                \\j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                \\'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                \\})(window,document,'script','dataLayer','GTM-5GXWQSF9');
            }
        </script>
    );
}

pub fn GtmBody(allocator: zx.Allocator) ?zx.Component {
    if (builtin.optimize == .debug) return null;

    return (
        <noscript @allocator={allocator}>
            <iframe src=`https://www.googletagmanager.com/ns.html?id={GTM_ID}` height="0" width="0" style="display:none;visibility:hidden"> </iframe>
        </noscript>
    );
}

pub fn Nav(allocator: zx.Allocator) zx.Component {
    return (
        <header @allocator={allocator} class="nav">
            <div class="nav-inner">
                <a class="nav-brand" href="/" aria-label="nuhu.dev home">
                    <span>nuhu<span class="nav-brand-dot">.</span>dev</span>
                </a>
                // <nav class="nav-links" aria-label="Primary">
                //     <a class="nav-link" href="#projects">Projects</a>
                //     <a class="nav-link" href={site_url} target="_blank" rel="noopener">
                //         About
                //         {icons.ArrowUpRight(allocator)}
                //     </a>
                //     <a class="nav-link nav-link-icon" href={github_url} target="_blank" rel="noopener" aria-label="GitHub">
                //         {icons.GitHub(allocator)}
                //     </a>
                // </nav>
            </div>
        </header>
    );
}

pub fn Footer(allocator: zx.Allocator) zx.Component {
    return (
        <footer @allocator={allocator} class="footer">
            <span>© nuhu.dev</span>
            <span class="footer-links">
                <a href={site_url} target="_blank" rel="noopener">nurulhudaapon.com</a>
                <a href={github_url} target="_blank" rel="noopener">GitHub</a>
                <a href="mailto:me@nurulhudaapon.com">Email</a>
            </span>
        </footer>
    );
}

pub const site_url = "https://nurulhudaapon.com";
pub const github_url = "https://github.com/nurulhudaapon";

