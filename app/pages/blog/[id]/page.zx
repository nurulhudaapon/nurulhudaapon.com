pub fn Page(ctx: zx.PageContext) !zx.Component {
    const slug = ctx.request.params.get("id") orelse return error.MissingParameter;
    const post = try posts.get(ctx.arena, ctx.io, slug, .html);
    ctx.data.set("title", post.seo_title orelse post.title);
    ctx.data.set("description", post.seo_description orelse post.brief);

    return (
        <main @allocator={ctx.arena} class="page-inner page-post">
            <div class="page-inner-content">
                <div class="page-nav">
                    <Navbar />
                </div>
                <a href="/blog" class="back-to-blog">
                    {icons.ArrowLeft(ctx.arena)}
                    Back to Blog
                </a>
                <article>
                    <header class="post-header">
                        <h1 class="post-title">{post.title}</h1>
                        {if (post.cover) |cover| (
                            <img src={cover} alt={post.title} class="post-cover" />
                        )}
                        <div class="post-meta">
                            <span>{post.date}</span>
                            <span>·</span>
                            <span>{post.read_minutes} min read</span>
                        </div>
                    </header>
                    <div class="post-content">
                        {if (post.content) |content| (
                            <div @escaping={.none}>{content}</div>
                        ) else (
                            <p>{post.brief}</p>
                        )}
                    </div>
                </article>
            </div>
        </main>
    );
}

fn staticParams(ctx: *zx.StaticContext) !void {
    for (try posts.list(ctx.arena, ctx.io)) |post| {
        try ctx.params.add(.{ .id = post.slug });
    }
}

pub const options: zx.PageOptions = .{
    .caching = .tag("7d"),
    .static = staticParams,
};

const posts = @import("../../../blog.zig").posts;
const zx = @import("zx");
const Navbar = @import("../../component.zx").Navbar;
const icons = @import("../../component.zx").icons;
